+#!/usr/bin/env python3
+"""Audit live documentation with screenshots and HTML analysis."""
+
+import asyncio
+import os
+import subprocess
+from pathlib import Path
+
+# Try to use installed playwright
+try:
+    from playwright.async_api import async_playwright
+
+    PLAYWRIGHT_AVAILABLE = True
+except ImportError:
+    PLAYWRIGHT_AVAILABLE = False
+    print("⚠️ Playwright not available for screenshots")
+
+BASE_URL = "https://pub-7f716b302a2948e19f08b49b71408039.r2.dev"
+OUTPUT_DIR = "/tmp/doc-audit"
+
+# Create output directory
+os.makedirs(OUTPUT_DIR, exist_ok=True)
+
+
+async def take_screenshots():
+    """Take screenshots of documentation pages."""
+    if not PLAYWRIGHT_AVAILABLE:
+        print("❌ Skipping screenshots - Playwright not available")
+        return
+
+    print("\n📸 Taking Screenshots")
+    print("=" * 50)
+
+    urls = [
+        (f"{BASE_URL}/", "main-page"),
+        (f"{BASE_URL}/index.html", "index"),
+        (f"{BASE_URL}/packages/haive-core/index.html", "haive-core"),
+        (f"{BASE_URL}/packages/haive-agents/index.html", "haive-agents"),
+    ]
+
+    async with async_playwright() as p:
+        browser = await p.chromium.launch(headless=True)
+        page = await browser.new_page(viewport={"width": 1920, "height": 1080})
+
+        for url, name in urls:
+            print(f"📸 Capturing {name}...")
+            try:
+                await page.goto(url, wait_until="networkidle")
+                screenshot_path = f"{OUTPUT_DIR}/{name}.png"
+                await page.screenshot(path=screenshot_path, full_page=True)
+                print(f"   ✅ Saved to {screenshot_path}")
+
+                # Get page title
+                title = await page.title()
+                print(f"   Title: {title}")
+
+                # Check for CSS
+                css_loaded = await page.evaluate(
+                    """() => {
+                    const sheets = document.styleSheets;
+                    return sheets.length;
+                }"""
+                )
+                print(f"   CSS files loaded: {css_loaded}")
+
+            except Exception as e:
+                print(f"   ❌ Error: {e}")
+
+        await browser.close()
+
+
+def audit_html_with_curl():
+    """Audit HTML structure and resources with curl."""
+    print("\n🔍 HTML Audit with curl")
+    print("=" * 50)
+
+    # Get main page HTML
+    print("\n📄 Fetching main page HTML...")
+    result = subprocess.run(
+        ["curl", "-s", f"{BASE_URL}/index.html"], capture_output=True, text=True
+    )
+
+    html_content = result.stdout
+    html_file = f"{OUTPUT_DIR}/index.html"
+
+    with open(html_file, "w") as f:
+        f.write(html_content)
+
+    print(f"   Saved HTML to {html_file}")
+    print(f"   Size: {len(html_content)} bytes")
+
+    # Analyze HTML
+    print("\n📊 HTML Analysis:")
+
+    # Check for CSS files
+    css_files = []
+    for line in html_content.split("\n"):
+        if "stylesheet" in line and "href=" in line:
+            import re
+
+            match = re.search(r'href="([^"]+\.css[^"]*)"', line)
+            if match:
+                css_files.append(match.group(1))
+
+    print(f"\n   CSS Files Found ({len(css_files)}):")
+    for css in css_files[:10]:  # Show first 10
+        print(f"   - {css}")
+
+    # Check for purple theme CSS
+    purple_theme_found = False
+    for css in css_files:
+        if "purple" in css.lower() or "code-purple" in css.lower():
+            print(f"\n   ✅ Purple theme CSS found: {css}")
+            purple_theme_found = True
+
+    if not purple_theme_found:
+        print("\n   ⚠️ Purple theme CSS not found in HTML")
+
+    # Check for JavaScript files
+    js_files = []
+    for line in html_content.split("\n"):
+        if "<script" in line and "src=" in line:
+            import re
+
+            match = re.search(r'src="([^"]+\.js[^"]*)"', line)
+            if match:
+                js_files.append(match.group(1))
+
+    print(f"\n   JavaScript Files Found ({len(js_files)}):")
+    for js in js_files[:10]:  # Show first 10
+        print(f"   - {js}")
+
+    # Check for Furo theme
+    if "furo" in html_content.lower():
+        print("\n   ✅ Furo theme detected")
+
+    # Check for navigation elements
+    if "sidebar" in html_content.lower():
+        print("   ✅ Sidebar navigation found")
+
+    if "toc-tree" in html_content.lower() or "toctree" in html_content.lower():
+        print("   ✅ Table of contents found")
+
+
+def verify_css_paths():
+    """Verify CSS files are accessible."""
+    print("\n🎨 Verifying CSS Paths")
+    print("=" * 50)
+
+    css_urls = [
+        f"{BASE_URL}/_static/basic.css",
+        f"{BASE_URL}/_static/code-purple-theme.css",
+        f"{BASE_URL}/_static/styles/furo.css",
+        f"{BASE_URL}/_static/styles/furo-extensions.css",
+        f"{BASE_URL}/_static/copybutton.css",
+        f"{BASE_URL}/_sphinx_design_static/sphinx-design.min.css",
+    ]
+
+    for url in css_urls:
+        # Use curl to check if CSS file exists
+        result = subprocess.run(
+            ["curl", "-s", "-o", "/dev/null", "-w", "%{http_code}", url],
+            capture_output=True,
+            text=True,
+        )
+
+        status_code = result.stdout.strip()
+        css_name = url.split("/")[-1]
+
+        if status_code == "200":
+            print(f"   ✅ {css_name}: {status_code}")
+
+            # Get first few lines of CSS
+            result = subprocess.run(["curl", "-s", url], capture_output=True, text=True)
+
+            if result.stdout:
+                first_line = result.stdout.split("\n")[0][:100]
+                print(f"      Content: {first_line}...")
+        else:
+            print(f"   ❌ {css_name}: {status_code}")
+
+
+def check_navigation():
+    """Check navigation and package links."""
+    print("\n🔗 Checking Navigation Links")
+    print("=" * 50)
+
+    packages = [
+        "haive-core",
+        "haive-agents",
+        "haive-tools",
+        "haive-mcp",
+        "haive-games",
+        "haive-dataflow",
+        "haive-prebuilt",
+        "haive-hap",
+    ]
+
+    for pkg in packages:
+        url = f"{BASE_URL}/packages/{pkg}/index.html"
+        result = subprocess.run(
+            ["curl", "-s", "-o", "/dev/null", "-w", "%{http_code}", url],
+            capture_output=True,
+            text=True,
+        )
+
+        status_code = result.stdout.strip()
+        if status_code == "200":
+            print(f"   ✅ {pkg}: {status_code}")
+        elif status_code == "404":
+            # Try without index.html
+            url = f"{BASE_URL}/packages/{pkg}/"
+            result = subprocess.run(
+                ["curl", "-s", "-o", "/dev/null", "-w", "%{http_code}", url],
+                capture_output=True,
+                text=True,
+            )
+            status_code = result.stdout.strip()
+            if status_code == "200":
+                print(f"   ✅ {pkg}/: {status_code}")
+            else:
+                print(f"   ❌ {pkg}: {status_code}")
+        else:
+            print(f"   ⚠️ {pkg}: {status_code}")
+
+
+async def main():
+    """Run all audits."""
+    print("🔍 Live Documentation Audit")
+    print("=" * 50)
+    print(f"URL: {BASE_URL}")
+    print(f"Output: {OUTPUT_DIR}")
+
+    # Take screenshots if Playwright is available
+    if PLAYWRIGHT_AVAILABLE:
+        await take_screenshots()
+
+    # Audit HTML
+    audit_html_with_curl()
+
+    # Verify CSS paths
+    verify_css_paths()
+
+    # Check navigation
+    check_navigation()
+
+    print("\n" + "=" * 50)
+    print("✅ Audit Complete!")
+    print(f"\nResults saved to: {OUTPUT_DIR}")
+
+    # List output files
+    output_files = os.listdir(OUTPUT_DIR)
+    if output_files:
+        print("\nGenerated files:")
+        for f in output_files:
+            size = os.path.getsize(f"{OUTPUT_DIR}/{f}")
+            print(f"   - {f} ({size:,} bytes)")
+
+
+if __name__ == "__main__":
+    if PLAYWRIGHT_AVAILABLE:
+        asyncio.run(main())
+    else:
+        # Run without async if Playwright not available
+        print("🔍 Live Documentation Audit (without screenshots)")
+        print("=" * 50)
+        print(f"URL: {BASE_URL}")
+        print(f"Output: {OUTPUT_DIR}")
+
+        audit_html_with_curl()
+        verify_css_paths()
+        check_navigation()
+
+        print("\n" + "=" * 50)
+        print("✅ Audit Complete!")
+        print(f"\nResults saved to: {OUTPUT_DIR}")
