+#!/usr/bin/env python3
+"""Verify R2 access and bucket configuration."""
+
+import datetime
+import hashlib
+import hmac
+import os
+import sys
+from urllib.parse import quote
+
+import requests
+
+
+# Load environment
+def load_env():
+    env_file = "/home/will/Projects/haive/.env"
+    if os.path.exists(env_file):
+        with open(env_file) as f:
+            for line in f:
+                if "=" in line and not line.startswith("#"):
+                    key, value = line.strip().split("=", 1)
+                    os.environ[key] = value
+
+
+load_env()
+
+# Get credentials
+account_id = os.environ.get("CLOUDFLARE_ACCOUNT_ID")
+access_key = os.environ.get("AWS_ACCESS_KEY_ID")
+secret_key = os.environ.get("AWS_SECRET_ACCESS_KEY")
+bucket = os.environ.get("CLOUDFLARE_R2_BUCKET", "haive-docs")
+
+if not all([account_id, access_key, secret_key]):
+    print("❌ Missing credentials in .env")
+    sys.exit(1)
+
+print("🔍 Verifying R2 Access")
+print("=" * 40)
+print(f"Account ID: {account_id}")
+print(f"Access Key: {access_key[:10]}...")
+print(f"Bucket: {bucket}")
+print("=" * 40)
+
+# Create a simple test using requests with manual signing
+endpoint = f"https://{account_id}.r2.cloudflarestorage.com"
+
+
+def sign_request(method, uri, headers, payload=""):
+    """Create AWS Signature v4."""
+    # Create canonical request
+    service = "s3"
+    region = "auto"
+
+    t = datetime.datetime.utcnow()
+    amz_date = t.strftime("%Y%m%dT%H%M%SZ")
+    date_stamp = t.strftime("%Y%m%d")
+
+    # Add required headers
+    headers["host"] = f"{account_id}.r2.cloudflarestorage.com"
+    headers["x-amz-date"] = amz_date
+    headers["x-amz-content-sha256"] = hashlib.sha256(payload.encode()).hexdigest()
+
+    # Create canonical headers
+    canonical_headers = ""
+    signed_headers = ""
+    for key in sorted(headers.keys()):
+        canonical_headers += f"{key.lower()}:{headers[key]}\n"
+        signed_headers += f"{key.lower()};"
+    signed_headers = signed_headers[:-1]
+
+    # Create canonical request
+    canonical_request = f"{method}\n{uri}\n\n{canonical_headers}\n{signed_headers}\n{headers['x-amz-content-sha256']}"
+
+    # Create string to sign
+    algorithm = "AWS4-HMAC-SHA256"
+    credential_scope = f"{date_stamp}/{region}/{service}/aws4_request"
+    string_to_sign = f"{algorithm}\n{amz_date}\n{credential_scope}\n{hashlib.sha256(canonical_request.encode()).hexdigest()}"
+
+    # Calculate signature
+    def sign(key, msg):
+        return hmac.new(key, msg.encode("utf-8"), hashlib.sha256).digest()
+
+    date_key = sign(("AWS4" + secret_key).encode("utf-8"), date_stamp)
+    region_key = sign(date_key, region)
+    service_key = sign(region_key, service)
+    signing_key = sign(service_key, "aws4_request")
+
+    signature = hmac.new(
+        signing_key, string_to_sign.encode("utf-8"), hashlib.sha256
+    ).hexdigest()
+
+    # Add auth header
+    headers["authorization"] = (
+        f"{algorithm} Credential={access_key}/{credential_scope}, SignedHeaders={signed_headers}, Signature={signature}"
+    )
+
+    return headers
+
+
+# Test 1: Check bucket exists with HEAD request
+print("\n📊 Test 1: Checking bucket access...")
+uri = f"/{bucket}"
+headers = {}
+headers = sign_request("HEAD", uri, headers)
+
+response = requests.head(f"{endpoint}{uri}", headers=headers)
+if response.status_code == 200:
+    print("✅ Bucket exists and is accessible")
+elif response.status_code == 404:
+    print("❌ Bucket does not exist")
+elif response.status_code == 403:
+    print("⚠️  Access denied - check credentials")
+else:
+    print(f"❓ Unexpected status: {response.status_code}")
+
+# Test 2: Try to list objects
+print("\n📊 Test 2: Listing bucket contents...")
+uri = f"/{bucket}?list-type=2&max-keys=5"
+headers = {}
+headers = sign_request("GET", uri, headers)
+
+response = requests.get(f"{endpoint}{uri}", headers=headers)
+if response.status_code == 200:
+    # Parse response
+    if "<Contents>" in response.text:
+        import re
+
+        keys = re.findall(r"<Key>(.*?)</Key>", response.text)
+        print(f"✅ Found {len(keys)} objects:")
+        for key in keys[:5]:
+            print(f"   - {key}")
+    else:
+        print("✅ Bucket is empty")
+elif response.status_code == 403:
+    print("⚠️  Cannot list objects - permission denied")
+else:
+    print(f"❓ Unexpected status: {response.status_code}")
+
+# Test 3: Try to upload a test file
+print("\n📊 Test 3: Testing upload capability...")
+test_content = f"Test upload at {datetime.datetime.now()}"
+uri = f"/{bucket}/test-verify.txt"
+headers = {"content-type": "text/plain"}
+headers = sign_request("PUT", uri, headers, test_content)
+
+response = requests.put(f"{endpoint}{uri}", headers=headers, data=test_content)
+if response.status_code in [200, 201]:
+    print("✅ Upload successful!")
+    print(
+        f"   View at: https://pub-7f716b302a2948e19f08b49b71408039.r2.dev/test-verify.txt"
+    )
+elif response.status_code == 403:
+    print("⚠️  Cannot upload - permission denied")
+else:
+    print(f"❓ Unexpected status: {response.status_code}")
+
+print("\n" + "=" * 40)
+print("📋 Summary:")
+if response.status_code in [200, 201]:
+    print("✅ Everything is working! Ready to upload docs.")
+    print("\nRun: ./scripts/r2_upload/upload_all.sh")
+else:
+    print("⚠️  There may be permission issues.")
+    print("\nCheck that your R2 API token has:")
+    print("  - Object Read & Write permissions")
+    print("  - Access to the 'haive-docs' bucket")
