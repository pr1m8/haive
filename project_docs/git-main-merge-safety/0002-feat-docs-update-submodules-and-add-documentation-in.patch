+    agent_types,
+    memory_usage,
+    color=["#2ecc71", "#f39c12", "#9b59b6", "#1abc9c"],
+    alpha=0.8,
+)
+ax2.set_xlabel("Agent Types")
+ax2.set_ylabel("Memory Usage (MB)")
