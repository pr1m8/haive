+#!/bin/bash
+# Centralized R2/S3 bucket configuration for documentation uploads
+# This file is sourced by all upload scripts
+
+# ===== BUCKET CONFIGURATION =====
+# Update these values to change the deployment target
+
+# Option 1: Cloudflare R2 Configuration
+STORAGE_TYPE="r2" # Options: "r2" or "s3"
+
+# R2 Configuration
+R2_ACCOUNT_ID="9508770013ee3de6f52f9bef82c78f73"
+R2_ENDPOINT="https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com"
+R2_BUCKET="haive-docs"
+R2_PUBLIC_URL="https://pub-7f716b302a2948e19f08b49b71408039.r2.dev" # Update if you get a new public URL
+
+# Option 2: AWS S3 Configuration (if using S3 instead of R2)
+S3_BUCKET=""     # TODO: Add your S3 bucket name
+S3_REGION=""     # TODO: Add your AWS region (e.g., us-east-1)
+S3_PUBLIC_URL="" # TODO: Add your S3 public URL or CloudFront distribution
+
+# ===== VALIDATION =====
+validate_config() {
+	if [ "$STORAGE_TYPE" = "r2" ]; then
+		if [ -z "$R2_ACCOUNT_ID" ] || [ -z "$R2_BUCKET" ] || [ -z "$R2_PUBLIC_URL" ]; then
+			echo "❌ Error: R2 configuration is incomplete!"
+			echo "   Please edit $(dirname "$0")/config.sh and set:"
+			echo "   - R2_ACCOUNT_ID"
+			echo "   - R2_BUCKET"
+			echo "   - R2_PUBLIC_URL"
+			exit 1
+		fi
+	elif [ "$STORAGE_TYPE" = "s3" ]; then
+		if [ -z "$S3_BUCKET" ] || [ -z "$S3_REGION" ]; then
+			echo "❌ Error: S3 configuration is incomplete!"
+			echo "   Please edit $(dirname "$0")/config.sh and set:"
+			echo "   - S3_BUCKET"
+			echo "   - S3_REGION"
+			echo "   - S3_PUBLIC_URL (optional)"
+			exit 1
+		fi
+	fi
+}
+
+# ===== DERIVED VARIABLES (DO NOT EDIT) =====
+if [ "$STORAGE_TYPE" = "r2" ]; then
+	ENDPOINT="$R2_ENDPOINT"
+	BUCKET="$R2_BUCKET"
+	PUBLIC_URL="$R2_PUBLIC_URL"
+	ENDPOINT_FLAG="--endpoint-url=$ENDPOINT"
+elif [ "$STORAGE_TYPE" = "s3" ]; then
+	ENDPOINT=""
+	BUCKET="$S3_BUCKET"
+	PUBLIC_URL="$S3_PUBLIC_URL"
+	ENDPOINT_FLAG=""
+	aws configure set default.region "$S3_REGION"
+fi
+
+# Validate configuration when sourced
+validate_config
+
+# ===== PACKAGE LIST =====
+PACKAGES="haive-core haive-agents haive-tools haive-mcp haive-games haive-dataflow haive-prebuilt haive-hap"
+
+# ===== HELPER FUNCTIONS =====
+setup_aws_cli() {
+	# Load environment variables
+	if [ -f "/home/will/Projects/haive/.env" ]; then
+		source /home/will/Projects/haive/.env
+
+		# Auto-populate R2 config from env if not set in this file
+		if [ "$STORAGE_TYPE" = "r2" ] && [ -z "$R2_ACCOUNT_ID" ]; then
+			[ -n "$CLOUDFLARE_ACCOUNT_ID" ] && R2_ACCOUNT_ID="$CLOUDFLARE_ACCOUNT_ID"
+			[ -n "$CLOUDFLARE_R2_BUCKET" ] && R2_BUCKET="$CLOUDFLARE_R2_BUCKET"
+			[ -n "$CLOUDFLARE_R2_ENDPOINT" ] && R2_ENDPOINT="$CLOUDFLARE_R2_ENDPOINT"
+
+			# Recalculate derived variables
+			ENDPOINT="$R2_ENDPOINT"
+			BUCKET="$R2_BUCKET"
+			ENDPOINT_FLAG="--endpoint-url=$ENDPOINT"
+		fi
+	fi
+
+	# Check for AWS credentials
+	if [ -z "$AWS_ACCESS_KEY_ID" ] || [ -z "$AWS_SECRET_ACCESS_KEY" ]; then
+		echo "❌ Error: AWS credentials not found in .env file!"
+		echo "   Please set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY"
+		exit 1
+	fi
+
+	# Configure AWS CLI
+	aws configure set aws_access_key_id "${AWS_ACCESS_KEY_ID}"
+	aws configure set aws_secret_access_key "${AWS_SECRET_ACCESS_KEY}"
+	aws configure set default.output json
+
+	if [ "$STORAGE_TYPE" = "r2" ]; then
+		aws configure set default.region "auto"
+	fi
+}
+
+print_upload_urls() {
+	echo ""
+	echo "🌐 Access your documentation at:"
+	echo "   Main: ${PUBLIC_URL}/"
+	echo ""
+	echo "📦 Package documentation:"
+	for package in $PACKAGES; do
+		echo "   - $package: ${PUBLIC_URL}/packages/$package/index.html"
+	done
+}
