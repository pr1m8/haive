+#!/usr/bin/env python3
+"""
+Upload Haive documentation to Cloudflare R2 storage.
+
+This script:
+1. Clears existing content in the R2 bucket
+2. Uploads the unified documentation system
+3. Sets up proper public access for documentation files
+"""
+
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+from dotenv import load_dotenv
+
+# Load environment variables
+load_dotenv()
+
+
+def run_command(cmd, description):
+    """Run a shell command with error handling."""
+    print(f"🔄 {description}")
+    print(f"   Command: {cmd}")
+
+    result = subprocess.run(cmd, shell=True, capture_output=True, text=True)
+
+    if result.returncode != 0:
+        print(f"❌ Error: {description}")
+        print(f"   stdout: {result.stdout}")
+        print(f"   stderr: {result.stderr}")
+        return False
+    else:
+        print(f"✅ Success: {description}")
+        if result.stdout.strip():
+            print(f"   Output: {result.stdout.strip()[:200]}")  # First 200 chars
+        return True
+
+
+def check_env_vars():
+    """Check that required environment variables are set."""
+    required_vars = [
+        "CLOUDFLARE_ACCOUNT_ID",
+        "CLOUDFLARE_API_KEY",
+        "CLOUDFLARE_R2_BUCKET",
+    ]
+
+    missing = []
+    for var in required_vars:
+        if not os.getenv(var):
+            missing.append(var)
+
+    if missing:
+        print(f"❌ Missing required environment variables: {', '.join(missing)}")
+        print("   Please check your .env file")
+        return False
+
+    print("✅ Environment variables loaded successfully")
+    return True
+
+
+def setup_aws_cli():
+    """Configure AWS CLI for Cloudflare R2."""
+    account_id = os.getenv("CLOUDFLARE_ACCOUNT_ID")
+    access_key_id = os.getenv("AWS_ACCESS_KEY_ID")
+    secret_access_key = os.getenv("AWS_SECRET_ACCESS_KEY")
+    endpoint = f"https://{account_id}.r2.cloudflarestorage.com"
+
+    commands = [
+        f"aws configure set aws_access_key_id {access_key_id}",
+        f"aws configure set aws_secret_access_key {secret_access_key}",
+        f"aws configure set default.region auto",
+        f"aws configure set default.s3.endpoint_url {endpoint}",
+    ]
+
+    for cmd in commands:
+        if not run_command(cmd, "Configuring AWS CLI for R2"):
+            return False
+
+    return True
+
+
+def clear_bucket():
+    """Clear all existing content from the R2 bucket."""
+    bucket = os.getenv("CLOUDFLARE_R2_BUCKET")
+    account_id = os.getenv("CLOUDFLARE_ACCOUNT_ID")
+    endpoint = f"https://{account_id}.r2.cloudflarestorage.com"
+
+    print(f"\n🗑️  Clearing existing content from bucket: {bucket}")
+
+    # List all objects first
+    cmd = f"aws s3 ls s3://{bucket}/ --recursive --endpoint-url={endpoint}"
+    if not run_command(cmd, "Listing existing objects"):
+        print("   No existing objects or bucket is empty")
+
+    # Delete all objects
+    cmd = f"aws s3 rm s3://{bucket}/ --recursive --endpoint-url={endpoint}"
+    return run_command(cmd, f"Clearing bucket {bucket}")
+
+
+def build_documentation():
+    """Build all documentation before uploading."""
+    print("\n🔨 Building documentation...")
+
+    base_dir = "/home/will/Projects/haive"
+
+    # Build main hub
+    print("   Building main documentation hub...")
+    cmd = f"cd {base_dir}/docs && poetry run sphinx-build -b html source build/html"
+    run_command(cmd, "Building main hub")
+
+    # Build package docs
+    packages = [
+        "haive-core",
+        "haive-agents",
+        "haive-mcp",
+        "haive-tools",
+        "haive-dataflow",
+        "haive-games",
+        "haive-prebuilt",
+        "haive-hap",
+    ]
+
+    for package in packages:
+        print(f"   Building {package} documentation...")
+        package_dir = f"{base_dir}/packages/{package}/docs"
+        if Path(f"{package_dir}/source").exists():
+            cmd = (
+                f"cd {package_dir} && poetry run sphinx-build -b html source build/html"
+            )
+            run_command(cmd, f"Building {package}")
+
+    return True
+
+
+def upload_documentation():
+    """Upload the unified documentation to R2."""
+    bucket = os.getenv("CLOUDFLARE_R2_BUCKET")
+    account_id = os.getenv("CLOUDFLARE_ACCOUNT_ID")
+    endpoint = f"https://{account_id}.r2.cloudflarestorage.com"
+
+    print(f"\n📤 Uploading documentation to bucket: {bucket}")
+
+    # Upload main hub documentation
+    main_docs = "/home/will/Projects/haive/docs/build/html"
+    if Path(main_docs).exists():
+        # Upload with proper content types
+        cmd = f"""aws s3 sync {main_docs}/ s3://{bucket}/ \
+            --endpoint-url={endpoint} \
+            --exclude '*.py' \
+            --exclude '*.pyc' \
+            --exclude '.doctrees/*' \
+            --content-type 'text/html' \
+            --metadata-directive REPLACE"""
+
+        if not run_command(cmd, "Uploading main documentation hub"):
+            return False
+
+        # Set correct content types for specific files
+        file_types = {
+            "*.css": "text/css",
+            "*.js": "application/javascript",
+            "*.json": "application/json",
+            "*.png": "image/png",
+            "*.jpg": "image/jpeg",
+            "*.svg": "image/svg+xml",
+            "*.ico": "image/x-icon",
+        }
+
+        for pattern, content_type in file_types.items():
+            cmd = f"""aws s3 cp {main_docs}/ s3://{bucket}/ \
+                --recursive \
+                --endpoint-url={endpoint} \
+                --exclude '*' \
+                --include '{pattern}' \
+                --content-type '{content_type}' \
+                --metadata-directive REPLACE"""
+            run_command(cmd, f"Setting content-type for {pattern}")
+    else:
+        print(f"⚠️  Warning: Main docs not found at {main_docs}")
+
+    # Upload individual package documentation
+    packages_base = "/home/will/Projects/haive/packages"
+    packages = [
+        "haive-core",
+        "haive-agents",
+        "haive-mcp",
+        "haive-tools",
+        "haive-dataflow",
+        "haive-games",
+        "haive-prebuilt",
+        "haive-hap",
+    ]
+
+    for package in packages:
+        package_docs = f"{packages_base}/{package}/docs/build/html"
+        if Path(package_docs).exists():
+            cmd = f"""aws s3 sync {package_docs}/ s3://{bucket}/packages/{package}/ \
+                --endpoint-url={endpoint} \
+                --exclude '*.py' \
+                --exclude '*.pyc' \
+                --exclude '.doctrees/*' \
+                --content-type 'text/html' \
+                --metadata-directive REPLACE"""
+            run_command(cmd, f"Uploading {package} documentation")
+        else:
+            print(f"⚠️  Warning: {package} docs not found at {package_docs}")
+
+    # Upload index redirect
+    create_index_redirect()
+
+    return True
+
+
+def create_index_redirect():
+    """Create an index.html that redirects to main documentation."""
+    index_content = """<!DOCTYPE html>
+<html>
+<head>
+    <title>Haive Documentation</title>
+    <meta http-equiv="refresh" content="0; url=/index.html">
+    <style>
+        body {
+            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+            display: flex;
+            justify-content: center;
+            align-items: center;
+            height: 100vh;
+            margin: 0;
+            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
+            color: white;
+        }
+        .container {
+            text-align: center;
+        }
+        h1 {
+            font-size: 3em;
+            margin-bottom: 0.5em;
+        }
+        p {
+            font-size: 1.2em;
+        }
+        a {
+            color: white;
+            text-decoration: underline;
+        }
+    </style>
+</head>
+<body>
+    <div class="container">
+        <h1>🚀 Haive Documentation</h1>
+        <p>Redirecting to documentation...</p>
+        <p>If you are not redirected, <a href="/index.html">click here</a>.</p>
+    </div>
+</body>
+</html>"""
+
+    # Save locally
+    index_path = "/tmp/index.html"
+    with open(index_path, "w") as f:
+        f.write(index_content)
+
+    # Upload to root
+    bucket = os.getenv("CLOUDFLARE_R2_BUCKET")
+    account_id = os.getenv("CLOUDFLARE_ACCOUNT_ID")
+    endpoint = f"https://{account_id}.r2.cloudflarestorage.com"
+
+    cmd = f"""aws s3 cp {index_path} s3://{bucket}/index.html \
+        --endpoint-url={endpoint} \
+        --content-type 'text/html' \
+        --cache-control 'public, max-age=3600'"""
+
+    run_command(cmd, "Uploading index redirect")
+
+
+def main():
+    """Main upload process."""
+    print("🚀 Haive Documentation Upload to Cloudflare R2")
+    print("=" * 50)
+
+    # Check environment
+    if not check_env_vars():
+        sys.exit(1)
+
+    # Setup AWS CLI
+    if not setup_aws_cli():
+        sys.exit(1)
+
+    # Ask user what to do
+    print("\nOptions:")
+    print("1. Build and upload all documentation")
+    print("2. Upload existing builds only")
+    print("3. Clear bucket only")
+
+    choice = input("\nSelect option (1-3): ").strip()
+
+    if choice == "1":
+        # Build documentation first
+        if not build_documentation():
+            print("⚠️  Some documentation failed to build - continuing anyway")
+
+        # Clear and upload
+        clear_bucket()
+        if not upload_documentation():
+            print("❌ Failed to upload documentation")
+            sys.exit(1)
+
+    elif choice == "2":
+        # Clear and upload existing builds
+        clear_bucket()
+        if not upload_documentation():
+            print("❌ Failed to upload documentation")
+            sys.exit(1)
+
+    elif choice == "3":
+        # Clear only
+        if not clear_bucket():
+            print("❌ Failed to clear bucket")
+            sys.exit(1)
+    else:
+        print("Invalid option")
