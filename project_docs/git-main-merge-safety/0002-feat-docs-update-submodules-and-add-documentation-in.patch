+#!/bin/bash
+# Audit documentation build status for all packages
+
+echo "📊 Documentation Build Audit"
+echo "===================================="
+echo ""
+
+PACKAGES="haive-core haive-agents haive-mcp haive-tools haive-dataflow haive-games haive-prebuilt haive-hap"
+TOTAL_HTML=0
+BUILT_PACKAGES=0
+
+for pkg in $PACKAGES; do
+	echo "📦 $pkg:"
+
+	BUILD_DIR="/home/will/Projects/haive/packages/$pkg/docs/build/html"
+
+	if [ -d "$BUILD_DIR" ]; then
+		# Count HTML files
+		HTML_COUNT=$(find "$BUILD_DIR" -name "*.html" 2>/dev/null | wc -l)
+
+		if [ $HTML_COUNT -gt 0 ]; then
+			echo "   ✅ Built: $HTML_COUNT HTML files"
+
+			# Check for key files
+			if [ -f "$BUILD_DIR/index.html" ]; then
+				echo "      ✓ index.html exists"
+			else
+				echo "      ✗ index.html missing"
+			fi
+
+			if [ -d "$BUILD_DIR/_static" ]; then
+				CSS_COUNT=$(ls "$BUILD_DIR/_static"/*.css 2>/dev/null | wc -l)
+				echo "      ✓ _static directory: $CSS_COUNT CSS files"
+
+				# Check for purple theme files
+				if [ -f "$BUILD_DIR/_static/purple-theme.css" ]; then
+					echo "      ✓ purple-theme.css present"
+				fi
+			else
+				echo "      ✗ _static directory missing"
+			fi
+
+			# Get size
+			SIZE=$(du -sh "$BUILD_DIR" 2>/dev/null | cut -f1)
+			echo "      📏 Size: $SIZE"
+
+			BUILT_PACKAGES=$((BUILT_PACKAGES + 1))
+			TOTAL_HTML=$((TOTAL_HTML + HTML_COUNT))
+		else
+			echo "   ⚠️  Build directory exists but no HTML files"
+		fi
+	else
+		echo "   ❌ Not built (no build directory)"
+	fi
+	echo ""
+done
+
+# Check main docs
+echo "📚 Main Documentation Hub:"
+MAIN_BUILD="/home/will/Projects/haive/docs/build/html"
+if [ -d "$MAIN_BUILD" ]; then
+	MAIN_HTML=$(find "$MAIN_BUILD" -name "*.html" 2>/dev/null | wc -l)
+	echo "   ✅ Built: $MAIN_HTML HTML files"
+
+	if [ -f "$MAIN_BUILD/packages_index.html" ]; then
+		echo "      ✓ packages_index.html exists"
+	fi
+
+	SIZE=$(du -sh "$MAIN_BUILD" 2>/dev/null | cut -f1)
+	echo "      📏 Size: $SIZE"
+else
+	echo "   ❌ Not built"
+fi
+
+echo ""
+echo "===================================="
+echo "📊 Summary:"
+echo "   Packages built: $BUILT_PACKAGES / 8"
+echo "   Total HTML files: $TOTAL_HTML"
+echo ""
+
+# Check what's in current R2 bucket (if configured)
+if [ -f "/home/will/Projects/haive/.env" ]; then
+	source /home/will/Projects/haive/.env
+
+	if [ -n "$CLOUDFLARE_ACCOUNT_ID" ] && [ -n "$CLOUDFLARE_R2_BUCKET" ]; then
+		echo "☁️  Current R2 Bucket Status:"
+		ENDPOINT="https://${CLOUDFLARE_ACCOUNT_ID}.r2.cloudflarestorage.com"
+		OBJECT_COUNT=$(aws s3 ls s3://${CLOUDFLARE_R2_BUCKET}/ --endpoint-url=${ENDPOINT} --recursive 2>/dev/null | wc -l)
+		echo "   Bucket: ${CLOUDFLARE_R2_BUCKET}"
+		echo "   Objects: $OBJECT_COUNT"
+	else
+		echo "☁️  R2 Bucket Status: Not configured"
+	fi
+else
+	echo "☁️  R2 Bucket Status: No .env file found"
+fi
