+#!/bin/bash
+# Test upload to R2
+
+# Load environment
+source /home/will/Projects/haive/.env
+
+echo "🧪 Testing R2 Upload"
+echo "==================="
+echo "Account: $CLOUDFLARE_ACCOUNT_ID"
+echo "Bucket: $CLOUDFLARE_R2_BUCKET"
+echo "Endpoint: $AWS_ENDPOINT_URL"
+echo ""
+
+# Create test file
+TEST_FILE="/tmp/test-$(date +%s).html"
+cat >"$TEST_FILE" <<EOF
+<!DOCTYPE html>
+<html>
+<head>
+    <title>R2 Upload Test</title>
+    <style>
+        body { font-family: Arial, sans-serif; margin: 50px; }
+        .success { color: green; }
+    </style>
+</head>
+<body>
+    <h1 class="success">✅ R2 Upload Working!</h1>
+    <p>Successfully uploaded at: $(date)</p>
+    <p>Bucket: $CLOUDFLARE_R2_BUCKET</p>
+    <p>This file is accessible at: <a href="https://pub-7f716b302a2948e19f08b49b71408039.r2.dev/test.html">https://pub-7f716b302a2948e19f08b49b71408039.r2.dev/test.html</a></p>
+</body>
+</html>
+EOF
+
+echo "📝 Created test file: $TEST_FILE"
+
+# Upload using curl with proper headers
+echo "📤 Uploading to R2..."
+
+# Calculate SHA256
+PAYLOAD_SHA=$(sha256sum "$TEST_FILE" | cut -d' ' -f1)
+
+# Current date for signing
+DATE=$(date -u +"%Y%m%dT%H%M%SZ")
+DATESTAMP=$(date -u +"%Y%m%d")
+
+# Use curl with AWS signature
+curl -X PUT \
+	--aws-sigv4 "aws:amz:auto:s3" \
+	--user "${AWS_ACCESS_KEY_ID}:${AWS_SECRET_ACCESS_KEY}" \
+	-H "Content-Type: text/html" \
+	-H "x-amz-content-sha256: $PAYLOAD_SHA" \
+	-H "x-amz-date: $DATE" \
+	-T "$TEST_FILE" \
+	"${AWS_ENDPOINT_URL}/${CLOUDFLARE_R2_BUCKET}/test.html" \
+	-w "\nHTTP Status: %{http_code}\n" \
+	-o /dev/null \
+	-s
+
+if [ $? -eq 0 ]; then
+	echo ""
+	echo "✅ Upload appears successful!"
+	echo ""
+	echo "🌐 Test your upload at:"
+	echo "   https://pub-7f716b302a2948e19f08b49b71408039.r2.dev/test.html"
+	echo ""
+	echo "📦 Ready to upload full documentation:"
+	echo "   ./scripts/r2_upload/upload_all.sh"
+else
+	echo "❌ Upload failed"
+fi
+
+# Clean up
+rm "$TEST_FILE"
