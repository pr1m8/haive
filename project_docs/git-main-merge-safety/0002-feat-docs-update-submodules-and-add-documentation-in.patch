+#!/usr/bin/env python3
+"""
+Clean/delete all content from Cloudflare R2 bucket.
+"""
+
+import os
+import subprocess
+import sys
+
+from dotenv import load_dotenv
+
+# Load environment variables
+load_dotenv()
+
+
+def run_command(cmd, description, show_output=True):
+    """Run a shell command with error handling."""
+    print(f"🔄 {description}")
+
+    result = subprocess.run(cmd, shell=True, capture_output=True, text=True)
+
+    if result.returncode != 0:
+        print(f"❌ Error: {description}")
+        if result.stderr:
+            print(f"   Error: {result.stderr[:500]}")
+        return False
+    else:
+        print(f"✅ Success: {description}")
+        if show_output and result.stdout.strip():
+            lines = result.stdout.strip().split("\n")
+            print(f"   Found {len(lines)} objects")
+        return True
+
+
+def setup_aws_cli():
+    """Configure AWS CLI for Cloudflare R2."""
+    account_id = os.getenv("CLOUDFLARE_ACCOUNT_ID")
+    access_key_id = os.getenv("AWS_ACCESS_KEY_ID")
+    secret_access_key = os.getenv("AWS_SECRET_ACCESS_KEY")
+
+    if not all([account_id, access_key_id, secret_access_key]):
+        print("❌ Error: Missing environment variables!")
+        print(
+            "   Please set CLOUDFLARE_ACCOUNT_ID, AWS_ACCESS_KEY_ID, and AWS_SECRET_ACCESS_KEY"
+        )
+        sys.exit(1)
+
+    endpoint = f"https://{account_id}.r2.cloudflarestorage.com"
+
+    print("🔧 Configuring AWS CLI for R2...")
+
+    commands = [
+        f"aws configure set aws_access_key_id {access_key_id}",
+        f"aws configure set aws_secret_access_key {secret_access_key}",
+        f"aws configure set default.region auto",
+    ]
+
+    for cmd in commands:
+        subprocess.run(cmd, shell=True, capture_output=True)
+
+    return endpoint
+
+
+def clean_bucket():
+    """Delete all objects from the R2 bucket."""
+    bucket = os.getenv("CLOUDFLARE_R2_BUCKET", "haive-docs")
+    account_id = os.getenv("CLOUDFLARE_ACCOUNT_ID")
+
+    if not account_id:
+        print("❌ Error: CLOUDFLARE_ACCOUNT_ID not set in environment!")
+        sys.exit(1)
+
+    endpoint = f"https://{account_id}.r2.cloudflarestorage.com"
+
+    print(f"\n🗑️  CLEANING BUCKET: {bucket}")
+    print(f"   Endpoint: {endpoint}")
+    print(f"   This will delete ALL content from the bucket")
+
+    # Confirm with user
+    confirm = input("\n⚠️  Are you sure you want to delete ALL content? (yes/no): ")
+    if confirm.lower() != "yes":
+        print("❌ Cleanup cancelled")
+        return False
+
+    print("\n📊 Listing current objects...")
+
+    # First, list to see what we're deleting
+    cmd = f"aws s3 ls s3://{bucket}/ --recursive --endpoint-url={endpoint} --summarize | tail -2"
+    run_command(cmd, "Getting object count")
+
+    print("\n🗑️  Deleting all objects...")
+
+    # Delete all objects (this handles batches automatically)
+    cmd = f"aws s3 rm s3://{bucket}/ --recursive --endpoint-url={endpoint}"
+
+    print("   This may take several minutes for 44k objects...")
+    result = subprocess.run(cmd, shell=True, capture_output=True, text=True)
+
+    if result.returncode == 0:
+        # Count deleted objects
+        deleted = len([line for line in result.stdout.split("\n") if "delete:" in line])
+        print(f"✅ Successfully deleted {deleted} objects")
+
+        # Verify bucket is empty
+        print("\n📊 Verifying bucket is empty...")
+        cmd = f"aws s3 ls s3://{bucket}/ --recursive --endpoint-url={endpoint} --summarize | tail -2"
+        run_command(cmd, "Checking remaining objects")
+
+        return True
+    else:
+        print(f"❌ Error during deletion")
+        if result.stderr:
+            print(f"   Error: {result.stderr[:500]}")
+        return False
+
+
+def main():
+    """Main cleanup process."""
+    account_id = os.getenv("CLOUDFLARE_ACCOUNT_ID", "Not configured")
+    bucket = os.getenv("CLOUDFLARE_R2_BUCKET", "Not configured")
+
+    print("🧹 Cloudflare R2 Bucket Cleanup Tool")
+    print("=" * 50)
+    print(f"   Account ID: {account_id}")
+    print(f"   Bucket: {bucket}")
+    print("=" * 50)
+
+    # Setup AWS CLI
+    endpoint = setup_aws_cli()
+
+    # Clean the bucket
+    if clean_bucket():
+        print("\n✅ Bucket cleaned successfully!")
+        print(f"   The {bucket} bucket is now empty")
+        print("   Ready to upload new documentation")
+    else:
+        print("\n❌ Cleanup failed or was cancelled")
+        sys.exit(1)
+
+
+if __name__ == "__main__":
+    main()
