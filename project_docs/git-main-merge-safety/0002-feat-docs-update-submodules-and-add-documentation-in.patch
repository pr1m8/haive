+#!/usr/bin/env python3
+"""
+Upload Haive documentation to Cloudflare R2 storage.
+
+This script:
+1. Clears existing content in the R2 bucket
+2. Uploads the unified documentation system
+3. Sets up proper public access for documentation files
+"""
+
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+from dotenv import load_dotenv
+
+# Load environment variables
+load_dotenv()
+
+
+def run_command(cmd, description):
+    """Run a shell command with error handling."""
+    print(f"🔄 {description}")
+    print(f"   Command: {cmd}")
+
+    result = subprocess.run(cmd, shell=True, capture_output=True, text=True)
+
+    if result.returncode != 0:
+        print(f"❌ Error: {description}")
+        print(f"   stdout: {result.stdout}")
+        print(f"   stderr: {result.stderr}")
+        return False
+    else:
+        print(f"✅ Success: {description}")
+        if result.stdout.strip():
+            print(f"   Output: {result.stdout.strip()}")
+        return True
+
+
+def check_env_vars():
+    """Check that required environment variables are set."""
+    required_vars = [
+        "CLOUDFLARE_ACCOUNT_ID",
+        "CLOUDFLARE_API_KEY",
+        "CLOUDFLARE_R2_BUCKET",
+    ]
+
+    missing = []
+    for var in required_vars:
+        if not os.getenv(var):
+            missing.append(var)
+
+    if missing:
+        print(f"❌ Missing required environment variables: {', '.join(missing)}")
+        print("   Please check your .env file")
+        return False
+
+    print("✅ Environment variables loaded successfully")
+    return True
+
+
+def setup_aws_cli():
+    """Configure AWS CLI for Cloudflare R2."""
+    account_id = os.getenv("CLOUDFLARE_ACCOUNT_ID")
+    api_key = os.getenv("CLOUDFLARE_API_KEY")
+    endpoint = f"https://{account_id}.r2.cloudflarestorage.com"
+
+    commands = [
+        f"aws configure set aws_access_key_id {api_key}",
+        f"aws configure set aws_secret_access_key {api_key}",  # R2 uses same key for both
+        f"aws configure set default.region auto",
+        f"aws configure set default.s3.endpoint_url {endpoint}",
+    ]
+
+    for cmd in commands:
+        if not run_command(cmd, "Configuring AWS CLI for R2"):
+            return False
+
+    return True
+
+
+def clear_bucket():
+    """Clear all existing content from the R2 bucket."""
+    bucket = os.getenv("CLOUDFLARE_R2_BUCKET")
+    account_id = os.getenv("CLOUDFLARE_ACCOUNT_ID")
+    endpoint = f"https://{account_id}.r2.cloudflarestorage.com"
+
+    print(f"\n🗑️  Clearing existing content from bucket: {bucket}")
+
+    # List all objects first
+    cmd = f"aws s3 ls s3://{bucket}/ --recursive --endpoint-url={endpoint}"
+    if not run_command(cmd, "Listing existing objects"):
+        return False
+
+    # Delete all objects
+    cmd = f"aws s3 rm s3://{bucket}/ --recursive --endpoint-url={endpoint}"
+    return run_command(cmd, f"Clearing bucket {bucket}")
+
+
+def upload_documentation():
+    """Upload the unified documentation to R2."""
+    bucket = os.getenv("CLOUDFLARE_R2_BUCKET")
+    account_id = os.getenv("CLOUDFLARE_ACCOUNT_ID")
+    endpoint = f"https://{account_id}.r2.cloudflarestorage.com"
+
+    print(f"\n📤 Uploading documentation to bucket: {bucket}")
+
+    # Upload main hub documentation
+    main_docs = "/home/will/Projects/haive/docs/build/html"
+    if Path(main_docs).exists():
+        cmd = f"aws s3 sync {main_docs}/ s3://{bucket}/main/ --endpoint-url={endpoint} --content-type text/html --exclude '*.py' --exclude '*.pyc'"
+        if not run_command(cmd, "Uploading main documentation hub"):
+            return False
+    else:
+        print(f"⚠️  Warning: Main docs not found at {main_docs}")
+
+    # Upload individual package documentation
+    packages_base = "/home/will/Projects/haive/packages"
+    packages = [
+        "haive-core",
+        "haive-agents",
+        "haive-mcp",
+        "haive-tools",
+        "haive-dataflow",
+        "haive-games",
+        "haive-prebuilt",
+        "haive-hap",
+    ]
+
+    for package in packages:
+        package_docs = f"{packages_base}/{package}/docs/build/html"
+        if Path(package_docs).exists():
+            cmd = f"aws s3 sync {package_docs}/ s3://{bucket}/packages/{package}/ --endpoint-url={endpoint} --content-type text/html --exclude '*.py' --exclude '*.pyc'"
+            run_command(cmd, f"Uploading {package} documentation")
+        else:
+            print(f"⚠️  Warning: {package} docs not found at {package_docs}")
+
+    return True
+
+
+def set_public_access():
+    """Set up public read access for documentation files."""
+    bucket = os.getenv("CLOUDFLARE_R2_BUCKET")
+
+    print(f"\n🌐 Setting up public access for bucket: {bucket}")
+    print(
+        "   Note: This requires bucket to be configured for public access in Cloudflare dashboard"
+    )
+
+    # The bucket policy would need to be set in Cloudflare dashboard
+    # or via the Cloudflare API directly
+    return True
+
+
+def main():
+    """Main upload process."""
+    print("🚀 Haive Documentation Upload to Cloudflare R2")
+    print("=" * 50)
+
+    # Check environment
+    if not check_env_vars():
+        sys.exit(1)
+
+    # Setup AWS CLI
+    if not setup_aws_cli():
+        sys.exit(1)
+
+    # Clear existing content
+    if not clear_bucket():
+        print("❌ Failed to clear bucket - continuing anyway")
+
+    # Upload new documentation
+    if not upload_documentation():
+        print("❌ Failed to upload documentation")
+        sys.exit(1)
+
+    # Set public access
+    set_public_access()
+
+    print("\n✅ Documentation upload completed successfully!")
+    print(
+        f"   Main docs: https://{os.getenv('CLOUDFLARE_R2_BUCKET')}.your-domain.com/main/"
+    )
+    print(
+        f"   Packages:  https://{os.getenv('CLOUDFLARE_R2_BUCKET')}.your-domain.com/packages/"
+    )
+
+
+if __name__ == "__main__":
+    main()
