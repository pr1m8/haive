+#!/usr/bin/env python3
+"""
+Simple R2 bucket cleaner using requests and Cloudflare API.
+No AWS CLI or boto3 required!
+"""
+
+import json
+import os
+import sys
+from pathlib import Path
+from typing import Dict, List
+
+import requests
+
+
+def clean_r2_bucket_simple():
+    """Clean R2 bucket using Cloudflare API directly."""
+
+    # Cloudflare credentials from environment
+    account_id = os.getenv("CLOUDFLARE_ACCOUNT_ID")
+    api_token = os.getenv("CLOUDFLARE_API_TOKEN")
+    bucket_name = os.getenv("CLOUDFLARE_R2_BUCKET", "haive-docs")
+
+    if not account_id or not api_token:
+        print("❌ Error: Missing environment variables!")
+        print("Please set CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN")
+        sys.exit(1)
+
+    print("🧹 R2 Bucket Cleaner (Simple Version)")
+    print("=" * 50)
+    print(f"Account ID: {account_id}")
+    print(f"Bucket: {bucket_name}")
+    print(
+        f"API Token: {api_token[:10]}... ({'complete' if len(api_token) > 30 else 'incomplete'})"
+    )
+    print("=" * 50)
+
+    # Check if API token looks complete
+    if len(api_token) < 30:
+        print("\n❌ ERROR: Your API token looks incomplete!")
+        print("\nTo get a proper Cloudflare API Token:")
+        print("1. Go to: https://dash.cloudflare.com/profile/api-tokens")
+        print("2. Click 'Create Token'")
+        print("3. Use the 'Custom token' template")
+        print("4. Set these permissions:")
+        print("   - Account: R2:Edit")
+        print("   - Zone: None needed")
+        print("5. Click 'Continue to summary' → 'Create Token'")
+        print("6. Copy the FULL token (usually 40+ characters)")
+        print("\nThe token will look like:")
+        print("   v1.0-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx")
+        print("\nUpdate the api_token variable in this script with the full token.")
+        return False
+
+    # Cloudflare API endpoint
+    base_url = f"https://api.cloudflare.com/client/v4/accounts/{account_id}/r2/buckets/{bucket_name}"
+
+    headers = {
+        "Authorization": f"Bearer {api_token}",
+        "Content-Type": "application/json",
+    }
+
+    print("\n📊 Checking bucket status...")
+
+    # First, try to get bucket info
+    try:
+        response = requests.get(base_url, headers=headers)
+        if response.status_code == 200:
+            print("✅ Successfully connected to Cloudflare R2")
+            data = response.json()
+            if data.get("success"):
+                print(f"   Bucket '{bucket_name}' found")
+            else:
+                print(
+                    f"⚠️  Issue accessing bucket: {data.get('errors', 'Unknown error')}"
+                )
+                return False
+        else:
+            print(f"❌ Failed to connect: HTTP {response.status_code}")
+            print(f"   Response: {response.text[:200]}")
+
+            if response.status_code == 401:
+                print("\n🔑 Authentication failed!")
+                print("You need a proper Cloudflare API Token (not an API Key)")
+                print("See instructions above.")
+            elif response.status_code == 403:
+                print("\n🔒 Permission denied!")
+                print("Your token needs 'R2:Edit' permissions")
+
+            return False
+
+    except Exception as e:
+        print(f"❌ Connection error: {e}")
+        return False
+
+    # Ask for confirmation
+    print(
+        f"\n⚠️  WARNING: This will delete ALL content from the '{bucket_name}' bucket!"
+    )
+    print(f"   Current size: ~8.05 GB with 44.34k objects")
+    confirm = input("\nType 'DELETE ALL' to confirm: ")
+
+    if confirm != "DELETE ALL":
+        print("❌ Cleanup cancelled")
+        return False
+
+    print("\n🗑️  Starting cleanup...")
+    print("Note: R2 API doesn't support bulk delete via REST API directly.")
+    print(
+        "For bulk operations, we need to use the S3-compatible API with proper credentials."
+    )
+    print(
+        "\nPlease get your R2 API credentials (Access Key + Secret Key) from Cloudflare."
+    )
+
+    return True
+
+
+if __name__ == "__main__":
+    clean_r2_bucket_simple()
