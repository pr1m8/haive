+def inject_navigation(html_file: Path) -> bool:
+    """Inject navigation dropdown into HTML file."""
+    try:
+        content = html_file.read_text()
+
+        # Check if navigation already exists
+        if "haive-nav-wrapper" in content:
+            return False
+
+        soup = BeautifulSoup(content, "html.parser")
+
+        # Find the main content article
+        main_content = soup.find("article", {"role": "main"})
+        if not main_content:
+            main_content = soup.find("div", {"class": "content"})
+
+        if main_content:
+            # Create navigation element
+            nav_soup = BeautifulSoup(NAVIGATION_HTML, "html.parser")
+            nav_element = nav_soup.find("div", {"class": "haive-nav-wrapper"})
+
+            # Insert navigation at the beginning of main content
+            if nav_element:
+                main_content.insert(0, nav_element)
+
+                # Write updated content
+                html_file.write_text(str(soup))
+                return True
+
+    except Exception as e:
+        print(f"Error processing {html_file}: {e}")
+
+    return False
+
+
+def process_directory(directory: Path, base_url: str = ""):
+    """Process all HTML files in directory."""
+    html_files = list(directory.rglob("*.html"))
+    print(f"Found {len(html_files)} HTML files to process")
+
+    updated = 0
+    for html_file in html_files:
+        if inject_navigation(html_file):
+            updated += 1
+            print(f"✅ Updated: {html_file.relative_to(directory)}")
+
+    print(f"\nProcessed {updated}/{len(html_files)} files")
+
+
+def main():
+    import sys
+
+    if len(sys.argv) < 2:
+        print("Usage: inject_navigation.py <docs_directory> [base_url]")
+        sys.exit(1)
+
+    docs_dir = Path(sys.argv[1])
+    base_url = sys.argv[2] if len(sys.argv) > 2 else ""
+
+    if not docs_dir.exists():
+        print(f"Directory not found: {docs_dir}")
+        sys.exit(1)
+
+    process_directory(docs_dir, base_url)
+
+
+if __name__ == "__main__":
+    main()
