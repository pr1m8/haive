+#!/usr/bin/env python3
+"""
+Simple R2 operations using subprocess to call curl with proper AWS signatures.
+"""
+
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+from dotenv import load_dotenv
+
+# Load environment
+load_dotenv()
+
+
+def setup_aws_config():
+    """Set up AWS config for R2."""
+    access_key = os.getenv("AWS_ACCESS_KEY_ID")
+    secret_key = os.getenv("AWS_SECRET_ACCESS_KEY")
+
+    if not access_key or not secret_key:
+        print("❌ Error: AWS credentials not found in environment!")
+        print("   Please set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY")
+        return False
+
+    # Write credentials to temp AWS config
+    aws_dir = Path.home() / ".aws"
+    aws_dir.mkdir(exist_ok=True)
+
+    config_content = f"""[default]
+region = auto
+"""
+
+    creds_content = f"""[default]
+aws_access_key_id = {access_key}
+aws_secret_access_key = {secret_key}
+"""
+
+    (aws_dir / "config").write_text(config_content)
+    (aws_dir / "credentials").write_text(creds_content)
+
+    print("✅ AWS credentials configured")
+    return True
+
+
+def test_connection():
+    """Test R2 connection using curl."""
+    print("🔧 Testing R2 Connection with curl")
+    print("=" * 50)
+
+    account_id = os.getenv("CLOUDFLARE_ACCOUNT_ID")
+    bucket = os.getenv("CLOUDFLARE_R2_BUCKET", "haive-docs")
+
+    if not account_id:
+        print("❌ Error: CLOUDFLARE_ACCOUNT_ID not set!")
+        return
+
+    endpoint = f"https://{account_id}.r2.cloudflarestorage.com"
+
+    # First set up credentials
+    setup_aws_config()
+
+    # Use AWS CLI if available, otherwise use curl
+    print("\n📊 Attempting to list bucket contents...")
+
+    # Try with curl and AWS signature
+    access_key = os.getenv("AWS_ACCESS_KEY_ID")
+    secret_key = os.getenv("AWS_SECRET_ACCESS_KEY")
+    cmd = f"""curl -s --aws-sigv4 "aws:amz:auto:s3" \
+        --user "{access_key}:{secret_key}" \
+        "{endpoint}/{bucket}?list-type=2&max-keys=5" """
+
+    result = subprocess.run(cmd, shell=True, capture_output=True, text=True)
+
+    if result.returncode == 0 and "Contents" in result.stdout:
+        print("✅ SUCCESS! Connection works!")
+        # Parse and show first few files
+        lines = result.stdout.split("\n")
+        for line in lines[:20]:
+            if "<Key>" in line:
+                key = line.strip().replace("<Key>", "").replace("</Key>", "")
+                print(f"  - {key[:60]}...")
+        return True
+    else:
+        print("❌ Connection failed")
+        print(f"Response: {result.stdout[:500]}")
+        print(f"Error: {result.stderr[:500]}")
+        return False
+
+
+def clean_bucket_simple():
+    """Clean bucket using simple approach."""
+    print("🧹 R2 Bucket Cleaner (Simple Version)")
+    print("=" * 50)
+
+    account_id = os.getenv("CLOUDFLARE_ACCOUNT_ID")
+    bucket = os.getenv("CLOUDFLARE_R2_BUCKET", "haive-docs")
+
+    if not account_id:
+        print("❌ Error: CLOUDFLARE_ACCOUNT_ID not set!")
+        return
+
+    endpoint = f"https://{account_id}.r2.cloudflarestorage.com"
+
+    print(f"Bucket: {bucket}")
+    print(f"Endpoint: {endpoint}")
+    print("Current size: ~8.05 GB (44.34k objects)")
+    print("=" * 50)
+
+    # Test connection first
+    if not test_connection():
+        print("\n❌ Cannot connect to R2. Please check credentials.")
+        return False
+
+    print(f"\n⚠️  WARNING: This will delete ALL content from '{bucket}'!")
+    confirm = input("\nType 'yes' to confirm deletion: ")
+
+    if confirm.lower() != "yes":
+        print("❌ Cleanup cancelled")
+        return False
+
+    print("\n🗑️  For bulk deletion, we need AWS CLI installed.")
+    print(
+        "Since AWS CLI installation is having issues, let me create a Python script for gradual deletion..."
+    )
+
+    # Create a deletion script
+    delete_script = """
+import subprocess
+import time
+
+# Get credentials from environment
+access_key = os.getenv("AWS_ACCESS_KEY_ID")
+secret_key = os.getenv("AWS_SECRET_ACCESS_KEY")
+account_id = os.getenv("CLOUDFLARE_ACCOUNT_ID")
+bucket = os.getenv("CLOUDFLARE_R2_BUCKET", "haive-docs")
+
+if not all([access_key, secret_key, account_id]):
+    print("❌ Error: Missing environment variables!")
+    sys.exit(1)
+
+endpoint = f"https://{account_id}.r2.cloudflarestorage.com"
+
+# List all objects
+list_cmd = f'curl -s --aws-sigv4 "aws:amz:auto:s3" --user "{access_key}:{secret_key}" "{endpoint}/{bucket}?list-type=2&max-keys=1000"'
+
+print("Getting object list...")
+result = subprocess.run(list_cmd, shell=True, capture_output=True, text=True)
+
+# Parse keys
+keys = []
+for line in result.stdout.split('\\n'):
+    if '<Key>' in line:
+        key = line.strip().replace('<Key>', '').replace('</Key>', '')
+        keys.append(key)
+
+print(f"Found {len(keys)} objects to delete")
+
+# Delete each object
+for i, key in enumerate(keys):
+    delete_cmd = f'curl -X DELETE -s --aws-sigv4 "aws:amz:auto:s3" --user "{access_key}:{secret_key}" "{endpoint}/{bucket}/{key}"'
+    subprocess.run(delete_cmd, shell=True)
+    if i % 100 == 0:
+        print(f"Deleted {i}/{len(keys)} objects...")
+        
+print(f"✅ Deleted {len(keys)} objects")
+"""
+
+    # Save script
+    script_path = Path("/tmp/delete_r2_objects.py")
+    script_path.write_text(delete_script)
+
+    print(f"\nCreated deletion script at: {script_path}")
+    print("Run it with: python /tmp/delete_r2_objects.py")
+
+    return True
+
+
+def main():
+    """Main entry point."""
+    if len(sys.argv) > 1 and sys.argv[1] == "clean":
+        clean_bucket_simple()
+    else:
+        test_connection()
+
+
+if __name__ == "__main__":
+    main()
