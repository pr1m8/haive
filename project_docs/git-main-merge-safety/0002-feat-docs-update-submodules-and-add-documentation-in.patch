+
+
+class MockAIMessage:
+    def __init__(self, content: str, tool_calls: list[dict[str, Any]] | None = None):
+        self.content = content
+        self.tool_calls = tool_calls or []
+
+
+# Mock the validation modes
+class ValidationMode:
+    STRICT = "strict"
