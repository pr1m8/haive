+#!/bin/bash
+
+# Fix directory links for R2 compatibility
+# R2/S3 doesn't serve index.html automatically for directory URLs
+# This script converts all directory links to explicit index.html links
+
+echo "🔧 Fixing directory links for R2 compatibility..."
+
+# Function to fix links in a directory
+fix_links_in_dir() {
+	local dir="$1"
+	echo "  Processing: $dir"
+
+	# Find all HTML files and fix directory links
+	find "$dir" -name "*.html" -type f | while read -r file; do
+		# Create a backup first
+		cp "$file" "$file.bak"
+
+		# Fix href links that end with / (directory links)
+		# Exclude anchors (#), external links (http/https), and already .html links
+		sed -i 's|href="\([^":#]*[^.html]\)/"|href="\1/index.html"|g' "$file"
+
+		# Also fix src links for any iframes or similar
+		sed -i 's|src="\([^":#]*[^.html]\)/"|src="\1/index.html"|g' "$file"
+
+		# Remove backup if sed succeeded
+		if [ $? -eq 0 ]; then
+			rm "$file.bak"
+		else
+			echo "    ⚠️  Error processing $file, backup retained"
+			mv "$file.bak" "$file"
+		fi
+	done
+}
+
+# Process main documentation
+if [ -d "/home/will/Projects/haive/docs/build/html" ]; then
+	echo "📚 Fixing main documentation..."
+	fix_links_in_dir "/home/will/Projects/haive/docs/build/html"
+fi
+
+# Process each package
+for package in haive-core haive-agents haive-tools haive-mcp haive-games haive-dataflow haive-prebuilt haive-hap; do
+	if [ -d "/home/will/Projects/haive/packages/$package/docs/build/html" ]; then
+		echo "📦 Fixing $package..."
+		fix_links_in_dir "/home/will/Projects/haive/packages/$package/docs/build/html"
+	fi
+done
+
+echo "✅ Link fixing complete!"
+echo ""
+echo "📊 Statistics:"
+echo "  Total HTML files processed: $(find /home/will/Projects/haive -name "*.html" -path "*/docs/build/html/*" | wc -l)"
+echo "  Packages processed: $(ls -d /home/will/Projects/haive/packages/*/docs/build/html 2>/dev/null | wc -l)"
+echo ""
+echo "💡 Next steps:"
+echo "  1. Upload the fixed documentation to R2"
+echo "  2. Test the links on the R2 URL"
