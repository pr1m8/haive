+#!/usr/bin/env python3
+"""
+Cloudflare R2 operations using Python requests - no AWS CLI needed.
+"""
+
+import datetime
+import hashlib
+import hmac
+import os
+import sys
+import xml.etree.ElementTree as ET
+from pathlib import Path
+from typing import Dict, List, Optional
+from urllib.parse import quote
+
+import requests
+from dotenv import load_dotenv
+
+# Load environment variables
+load_dotenv()
+
+
+class R2Client:
+    """Simple R2 client using S3-compatible API."""
+
+    def __init__(self):
+        # Get from environment variables
+        self.account_id = os.getenv("CLOUDFLARE_ACCOUNT_ID")
+        self.access_key = os.getenv("AWS_ACCESS_KEY_ID")
+        self.secret_key = os.getenv("AWS_SECRET_ACCESS_KEY")
+        self.bucket = os.getenv("CLOUDFLARE_R2_BUCKET", "haive-docs")
+
+        if not all([self.account_id, self.access_key, self.secret_key]):
+            raise ValueError(
+                "Missing required environment variables: CLOUDFLARE_ACCOUNT_ID, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY"
+            )
+
+        self.endpoint = f"https://{self.account_id}.r2.cloudflarestorage.com"
+        self.region = "auto"
+
+    def _sign_request(
+        self, method: str, path: str, headers: Dict, payload: bytes = b""
+    ) -> Dict:
+        """Sign request with AWS Signature Version 4."""
+        # Create canonical request
+        now = datetime.datetime.utcnow()
+        datestamp = now.strftime("%Y%m%d")
+        timestamp = now.strftime("%Y%m%dT%H%M%SZ")
+
+        headers["x-amz-date"] = timestamp
+        headers["x-amz-content-sha256"] = hashlib.sha256(payload).hexdigest()
+
+        # Sort headers
+        canonical_headers = "".join(
+            f"{k.lower()}:{v}\n" for k, v in sorted(headers.items())
+        )
+        signed_headers = ";".join(sorted(k.lower() for k in headers.keys()))
+
+        canonical_request = f"{method}\n{path}\n\n{canonical_headers}\n{signed_headers}\n{headers['x-amz-content-sha256']}"
+
+        # Create string to sign
+        algorithm = "AWS4-HMAC-SHA256"
+        credential_scope = f"{datestamp}/{self.region}/s3/aws4_request"
+        string_to_sign = f"{algorithm}\n{timestamp}\n{credential_scope}\n{hashlib.sha256(canonical_request.encode()).hexdigest()}"
+
+        # Calculate signature
+        def sign(key, msg):
+            return hmac.new(key, msg.encode("utf-8"), hashlib.sha256).digest()
+
+        k_date = sign(f"AWS4{self.secret_key}".encode(), datestamp)
+        k_region = sign(k_date, self.region)
+        k_service = sign(k_region, "s3")
+        k_signing = sign(k_service, "aws4_request")
+        signature = hmac.new(
+            k_signing, string_to_sign.encode(), hashlib.sha256
+        ).hexdigest()
+
+        # Add authorization header
+        headers["Authorization"] = (
+            f"{algorithm} Credential={self.access_key}/{credential_scope}, SignedHeaders={signed_headers}, Signature={signature}"
+        )
+
+        return headers
+
+    def list_objects(self, prefix: str = "", max_keys: int = 1000) -> List[Dict]:
+        """List objects in bucket."""
+        path = f"/{self.bucket}"
+        params = f"?list-type=2&max-keys={max_keys}"
+        if prefix:
+            params += f"&prefix={quote(prefix)}"
+
+        headers = {"Host": f"{self.account_id}.r2.cloudflarestorage.com"}
+        headers = self._sign_request("GET", path + params, headers)
+
+        response = requests.get(f"{self.endpoint}{path}{params}", headers=headers)
+
+        if response.status_code != 200:
+            print(f"Error listing objects: {response.status_code}")
+            print(response.text[:500])
+            return []
+
+        # Parse XML response
+        root = ET.fromstring(response.text)
+        ns = {"s3": "http://s3.amazonaws.com/doc/2006-03-01/"}
+
+        objects = []
+        for content in root.findall(".//s3:Contents", ns):
+            key = content.find("s3:Key", ns)
+            size = content.find("s3:Size", ns)
+            if key is not None:
+                objects.append(
+                    {"Key": key.text, "Size": int(size.text) if size is not None else 0}
+                )
+
+        return objects
+
+    def delete_object(self, key: str) -> bool:
+        """Delete a single object."""
+        path = f"/{self.bucket}/{quote(key, safe='')}"
+        headers = {"Host": f"{self.account_id}.r2.cloudflarestorage.com"}
+        headers = self._sign_request("DELETE", path, headers)
+
+        response = requests.delete(f"{self.endpoint}{path}", headers=headers)
+        return response.status_code in [200, 204]
+
+    def delete_all_objects(self) -> int:
+        """Delete all objects in the bucket."""
+        deleted_count = 0
+        continuation_token = None
+
+        while True:
+            # List batch of objects
+            objects = self.list_objects(max_keys=1000)
+
+            if not objects:
+                break
+
+            print(f"Deleting batch of {len(objects)} objects...")
+
+            # Delete each object
+            for obj in objects:
+                if self.delete_object(obj["Key"]):
+                    deleted_count += 1
+                    if deleted_count % 100 == 0:
+                        print(f"  Deleted {deleted_count} objects...")
+
+            # Check if more objects exist
+            if len(objects) < 1000:
+                break
+
+        return deleted_count
+
+
+def test_connection():
+    """Test R2 connection."""
+    print("🔧 Testing R2 Connection")
+    print("=" * 50)
+
+    client = R2Client()
+    print(f"Account ID: {client.account_id}")
+    print(f"Access Key: {client.access_key[:10]}...")
+    print(f"Secret Key: {'*' * 10}...")
+    print(f"Bucket: {client.bucket}")
+    print(f"Endpoint: {client.endpoint}")
+    print("=" * 50)
+
+    print("\n📊 Listing first 5 objects...")
+    objects = client.list_objects(max_keys=5)
+
+    if objects:
+        print(f"✅ SUCCESS! Found {len(objects)} objects:")
+        for obj in objects[:5]:
+            size_mb = obj["Size"] / (1024 * 1024)
+            print(f"  - {obj['Key'][:50]}... ({size_mb:.2f} MB)")
+        return True
+    else:
+        print("❌ No objects found or connection failed")
+        return False
+
+
+def clean_bucket():
+    """Clean all objects from bucket."""
+    print("🧹 R2 Bucket Cleaner")
+    print("=" * 50)
+
+    client = R2Client()
+
+    # Get object count
+    print("📊 Checking bucket contents...")
+    objects = client.list_objects(max_keys=10)
+
+    if not objects:
+        print("✅ Bucket is already empty!")
+        return
+
+    print(f"Found objects in bucket (showing first 10):")
+    for obj in objects[:10]:
+        print(f"  - {obj['Key'][:60]}...")
+
+    print(f"\n⚠️  WARNING: This will delete ALL content from '{client.bucket}'!")
+    print(f"   Estimated: ~44.34k objects, ~8.05 GB")
+
+    confirm = input("\nType 'yes' to confirm deletion: ")
+    if confirm.lower() != "yes":
+        print("❌ Cleanup cancelled")
+        return
+
+    print("\n🗑️  Starting deletion...")
+    deleted = client.delete_all_objects()
+
+    print(f"\n✅ Successfully deleted {deleted} objects!")
+    print(f"   Bucket '{client.bucket}' is now empty")
+
+
+def main():
+    """Main entry point."""
+    if len(sys.argv) > 1 and sys.argv[1] == "clean":
+        clean_bucket()
+    else:
+        test_connection()
+
+
+if __name__ == "__main__":
+    main()
