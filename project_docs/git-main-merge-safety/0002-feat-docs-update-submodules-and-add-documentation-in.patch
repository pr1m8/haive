+#!/usr/bin/env python3
+"""Take screenshots of live documentation."""
+
+import asyncio
+import os
+import sys
+
+sys.path.insert(0, os.path.expanduser("~/.local/lib/python3.10/site-packages"))
+
+try:
+    from playwright.async_api import async_playwright
+except ImportError:
+    print("Installing Playwright...")
+    import subprocess
+
+    subprocess.check_call(
+        [sys.executable, "-m", "pip", "install", "--user", "playwright"]
+    )
+    from playwright.async_api import async_playwright
+
+
+async def take_screenshots():
+    """Take screenshots of documentation pages."""
+    BASE_URL = "https://pub-7f716b302a2948e19f08b49b71408039.r2.dev"
+    OUTPUT_DIR = "/tmp/doc-screenshots"
+    os.makedirs(OUTPUT_DIR, exist_ok=True)
+
+    print("📸 Taking Documentation Screenshots")
+    print("=" * 50)
+
+    urls = [
+        (f"{BASE_URL}/", "home"),
+        (f"{BASE_URL}/index.html", "main-index"),
+        (f"{BASE_URL}/packages/haive-core/index.html", "haive-core"),
+        (f"{BASE_URL}/packages/haive-agents/index.html", "haive-agents"),
+    ]
+
+    try:
+        async with async_playwright() as p:
+            print("Launching browser...")
+            browser = await p.chromium.launch(headless=True)
+            context = await browser.new_context(
+                viewport={"width": 1920, "height": 1080}, device_scale_factor=2
+            )
+            page = await context.new_page()
+
+            for url, name in urls:
+                print(f"\n📸 Capturing {name}...")
+                print(f"   URL: {url}")
+
+                try:
+                    # Navigate to page
+                    response = await page.goto(
+                        url, wait_until="domcontentloaded", timeout=30000
+                    )
+
+                    if response:
+                        print(f"   Status: {response.status}")
+
+                    # Wait for styles to load
+                    await page.wait_for_timeout(2000)
+
+                    # Take full page screenshot
+                    screenshot_path = f"{OUTPUT_DIR}/{name}-full.png"
+                    await page.screenshot(path=screenshot_path, full_page=True)
+                    print(f"   ✅ Full page: {screenshot_path}")
+
+                    # Take viewport screenshot
+                    viewport_path = f"{OUTPUT_DIR}/{name}-viewport.png"
+                    await page.screenshot(path=viewport_path, full_page=False)
+                    print(f"   ✅ Viewport: {viewport_path}")
+
+                    # Get page info
+                    title = await page.title()
+                    print(f"   Title: {title}")
+
+                    # Check for CSS
+                    css_info = await page.evaluate(
+                        """() => {
+                        const sheets = Array.from(document.styleSheets);
+                        const purpleTheme = sheets.filter(s => s.href && s.href.includes('purple'));
+                        return {
+                            total: sheets.length,
+                            purple: purpleTheme.length,
+                            hasPurple: purpleTheme.length > 0
+                        };
+                    }"""
+                    )
+
+                    print(f"   CSS: {css_info['total']} stylesheets loaded")
+                    if css_info["hasPurple"]:
+                        print(
+                            f"   ✅ Purple theme CSS detected ({css_info['purple']} files)"
+                        )
+
+                    # Check for sidebar
+                    sidebar = await page.query_selector(".sidebar-container")
+                    if sidebar:
+                        print("   ✅ Sidebar navigation present")
+
+                except Exception as e:
+                    print(f"   ❌ Error: {e}")
+
+            await browser.close()
+
+    except Exception as e:
+        print(f"\n❌ Browser error: {e}")
+        print("\nTrying to install Chromium...")
+        import subprocess
+
+        try:
+            subprocess.run(
+                [sys.executable, "-m", "playwright", "install", "chromium"], check=True
+            )
+            print("✅ Chromium installed. Please run the script again.")
+        except:
+            print("❌ Could not install Chromium")
+
+    print("\n" + "=" * 50)
+    print(f"✅ Screenshots saved to: {OUTPUT_DIR}")
+
+    # List generated files
+    if os.path.exists(OUTPUT_DIR):
+        files = os.listdir(OUTPUT_DIR)
+        if files:
+            print("\nGenerated screenshots:")
+            for f in sorted(files):
+                size = os.path.getsize(f"{OUTPUT_DIR}/{f}")
+                print(f"   - {f} ({size:,} bytes)")
+
+
+if __name__ == "__main__":
+    asyncio.run(take_screenshots())
