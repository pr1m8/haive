+	sed -i 's/^STORAGE_TYPE=.*/STORAGE_TYPE="r2"/' "$CONFIG_FILE"
+	sed -i "s/^R2_ACCOUNT_ID=.*/R2_ACCOUNT_ID=\"$account_id\"/" "$CONFIG_FILE"
+	sed -i "s/^R2_BUCKET=.*/R2_BUCKET=\"$bucket_name\"/" "$CONFIG_FILE"
+	sed -i "s|^R2_PUBLIC_URL=.*|R2_PUBLIC_URL=\"$public_url\"|" "$CONFIG_FILE"
+
+	echo ""
+	echo "✅ R2 configuration saved!"
+	echo ""
+	echo "Next steps:"
+	echo "1. Set up your R2 API credentials in .env:"
+	echo "   AWS_ACCESS_KEY_ID=your_r2_access_key"
+	echo "   AWS_SECRET_ACCESS_KEY=your_r2_secret_key"
+	echo ""
+	echo "2. Run: ./upload_all.sh"
+
+elif [ "$choice" = "2" ]; then
+	echo ""
+	echo "☁️ Configuring AWS S3..."
+	echo ""
+
+	read -p "Enter your S3 Bucket name: " bucket_name
+	read -p "Enter your AWS Region (e.g., us-east-1): " region
+	read -p "Enter your S3 Public URL (optional, press Enter to skip): " public_url
+
+	if [ -z "$public_url" ]; then
+		public_url="https://${bucket_name}.s3.amazonaws.com"
+	fi
+
+	# Update config.sh
+	sed -i 's/^STORAGE_TYPE=.*/STORAGE_TYPE="s3"/' "$CONFIG_FILE"
+	sed -i "s/^S3_BUCKET=.*/S3_BUCKET=\"$bucket_name\"/" "$CONFIG_FILE"
+	sed -i "s/^S3_REGION=.*/S3_REGION=\"$region\"/" "$CONFIG_FILE"
+	sed -i "s|^S3_PUBLIC_URL=.*|S3_PUBLIC_URL=\"$public_url\"|" "$CONFIG_FILE"
+
+	echo ""
+	echo "✅ S3 configuration saved!"
+	echo ""
+	echo "Next steps:"
+	echo "1. Set up your AWS credentials in .env:"
+	echo "   AWS_ACCESS_KEY_ID=your_aws_access_key"
+	echo "   AWS_SECRET_ACCESS_KEY=your_aws_secret_key"
+	echo ""
+	echo "2. Run: ./upload_all.sh"
+
+else
+	echo "❌ Invalid choice. Please run the script again."
+	exit 1
+fi
+
+echo ""
+echo "===================================="
+echo "Configuration complete! 🎉"
