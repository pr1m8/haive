# Flake8 Configuration for Haive
# Comprehensive linting with all plugins enabled

[flake8]
max-line-length = 88
max-complexity = 10

# Enable all installed plugins
select =
    E,      # pycodestyle errors
    W,      # pycodestyle warnings
    F,      # pyflakes
    C,      # mccabe complexity
    B,      # flake8-bugbear
    C4,     # flake8-comprehensions
    SIM,    # flake8-simplify
    D,      # flake8-docstrings
    RST,    # flake8-rst-docstrings

# Ignore conflicts with black and ruff
ignore =
    E203,   # whitespace before ':'
    W503,   # line break before binary operator
    D100,   # Missing docstring in public module (too strict)
    D104,   # Missing docstring in public package (too strict)
    RST210, # Inline strong start-string without end-string
    RST213, # Inline emphasis start-string without end-string

# File patterns to check
include = *.py
exclude =
    .git,
    __pycache__,
    .venv,
    .nox,
    build,
    dist,
    *.egg-info,
    .trunk

# Per-file ignores
per-file-ignores =
    # Tests don't need docstrings
    tests/*.py:D,RST
    # Examples can have print statements
    examples/*.py:T201
    # Config files can be less strict
    *config*.py:D,RST

# Docstring conventions
docstring-convention = google

# RST docstring settings
rst-roles =
    py:attr,py:class,py:func,py:meth,py:mod,
    doc,ref,term

rst-directives =
    deprecated,note,seealso,todo,versionadded,versionchanged,warning
