+
+# Documentation Utilities Sessions
+@nox.session(python=PYTHON_VERSIONS)
+def doc_utils_analyze(session):
+    """Run agent analysis and generate comprehensive report."""
+    session.log("🔍 Running comprehensive agent analysis...")
+    
+    # Install dependencies
+    session.run("poetry", "install", "--with", "docs", external=True)
+    
+    # Create output directory
+    output_dir = Path("docs/build/agent_analysis")
+    output_dir.mkdir(parents=True, exist_ok=True)
+    
+    # Run analysis with report generation
+    session.run(
+        "poetry", "run", "python", "scripts/doc_utils_runner.py",
+        "analyze", "--report", "--output", str(output_dir / "agent_analysis_report.md"),
+        external=True
+    )
+    
+    session.log(f"✅ Analysis report generated: {output_dir / 'agent_analysis_report.md'}")
+
+
+@nox.session(python=PYTHON_VERSIONS)  
+def doc_utils_examples(session):
+    """Discover all examples and validate they can run."""
+    session.log("📋 Discovering and validating all examples...")
+    
+    # Install dependencies
+    session.run("poetry", "install", "--with", "docs", external=True)
+    
+    # Create output directory
+    output_dir = Path("docs/build/examples")
+    output_dir.mkdir(parents=True, exist_ok=True)
+    
+    # First discover all examples
+    session.log("🔍 Discovering examples...")
+    session.run(
+        "poetry", "run", "python", "scripts/doc_utils_runner.py",
+        "run", "--discover",
+        external=True
+    )
+    
+    # Generate example execution report (without actually running all - too slow)
+    session.run(
+        "poetry", "run", "python", "scripts/doc_utils_runner.py", 
+        "run", "--run-all", "--output", str(output_dir / "example_validation_report.md"),
+        "--max-concurrent", "2", "--timeout", "60",  # Quick validation
+        external=True
+    )
+    
+    session.log(f"✅ Example validation report: {output_dir / 'example_validation_report.md'}")
+
+
+@nox.session(python=PYTHON_VERSIONS)
+def doc_utils_visualize(session):
+    """Generate visualizations for all agents."""
+    session.log("🎨 Generating agent visualizations...")
+    
+    # Install dependencies  
+    session.run("poetry", "install", "--with", "docs", external=True)
+    
+    # Create output directory
+    output_dir = Path("docs/build/visualizations")
+    output_dir.mkdir(parents=True, exist_ok=True)
+    
+    # Generate comparison visualization
+    session.log("📊 Creating agent comparison...")
+    session.run(
+        "poetry", "run", "python", "scripts/doc_utils_runner.py",
+        "visualize", "--compare", "--format", "html", "--theme", "default",
+        "--output", str(output_dir / "agent_comparison.html"),
+        external=True
+    )
+    
+    # Generate individual visualizations for key agents
+    key_agents = ["SimpleAgent", "ReactAgent", "MultiAgent"]
+    for agent in key_agents:
+        session.log(f"🎯 Visualizing {agent}...")
+        try:
+            session.run(
+                "poetry", "run", "python", "scripts/doc_utils_runner.py",
+                "visualize", "--agent-name", agent, "--format", "png",
+                "--output", str(output_dir / f"{agent.lower()}_workflow.png"),
+                external=True
+            )
+        except Exception as e:
+            session.log(f"⚠️  Could not visualize {agent}: {e}")
+    
+    session.log(f"✅ Visualizations generated in: {output_dir}")
+
+
+@nox.session(python=PYTHON_VERSIONS)
+def doc_utils_generate(session):
+    """Generate comprehensive documentation using doc utilities."""
+    session.log("📚 Generating comprehensive documentation...")
+    
+    # Install dependencies
+    session.run("poetry", "install", "--with", "docs", external=True)
+    
+    # Create output directory
+    output_dir = Path("docs/build/generated_docs")
+    output_dir.mkdir(parents=True, exist_ok=True)
+    
+    # Generate project-wide documentation
+    session.run(
+        "poetry", "run", "python", "scripts/doc_utils_runner.py",
+        "docs", "--format", "markdown", "--style", "comprehensive",
+        "--api-docs", "--output", str(output_dir),
+        external=True
+    )
+    
+    session.log(f"✅ Generated documentation in: {output_dir}")
+
+
+@nox.session(python=PYTHON_VERSIONS)
+def doc_utils_full(session):
+    """Run complete documentation utilities workflow."""
+    session.log("🚀 Running complete documentation utilities workflow...")
+    
+    # Run all doc utilities sessions in sequence
+    sessions_to_run = [
+        "doc_utils_analyze",
+        "doc_utils_examples", 
+        "doc_utils_visualize",
+        "doc_utils_generate"
+    ]
+    
+    for session_name in sessions_to_run:
+        session.log(f"▶️  Running {session_name}...")
+        try:
+            session.run("nox", "-s", session_name, external=True)
+            session.log(f"✅ {session_name} completed")
+        except Exception as e:
+            session.log(f"⚠️  {session_name} failed: {e}")
+    
+    # Create summary index
+    summary_file = Path("docs/build/doc_utils_summary.md")
+    
+    summary_content = f"""# Documentation Utilities Summary
+
+Generated on {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}
+
+## 📊 Generated Content
+
+### Agent Analysis
+- **Report**: [agent_analysis/agent_analysis_report.md](./agent_analysis/agent_analysis_report.md)
+- Comprehensive analysis of all agent types, architectures, and capabilities
+
+### Example Validation  
+- **Report**: [examples/example_validation_report.md](./examples/example_validation_report.md)
+- Discovery and validation of all example files across the project
+
+### Visualizations
+- **Comparison**: [visualizations/agent_comparison.html](./visualizations/agent_comparison.html)
+- **Individual**: Agent workflow diagrams in PNG format
+
+### Generated Documentation
+- **Project Docs**: [generated_docs/](./generated_docs/)
+- Comprehensive documentation for all agents with cross-references
+
+## 🎯 Quick Access
+
+- View the [Agent Comparison](./visualizations/agent_comparison.html) for visual overview
+- Read the [Analysis Report](./agent_analysis/agent_analysis_report.md) for detailed insights
+- Browse [Generated Docs](./generated_docs/) for comprehensive agent documentation
+
+## 🔄 Regenerating
+
+To regenerate any component:
+
+```bash
+nox -s doc_utils_analyze     # Agent analysis
+nox -s doc_utils_examples    # Example validation
+nox -s doc_utils_visualize   # Visualizations
+nox -s doc_utils_generate    # Documentation
+nox -s doc_utils_full        # Complete workflow
+```
+"""
+    
+    with open(summary_file, 'w') as f:
+        f.write(summary_content)
+    
+    session.log("=" * 60)
+    session.log("🎉 DOCUMENTATION UTILITIES COMPLETE")
+    session.log("=" * 60)
+    session.log(f"📋 Summary: {summary_file}")
+    session.log("🌐 View results:")
+    session.log(f"  - Agent Analysis: docs/build/agent_analysis/")
+    session.log(f"  - Visualizations: docs/build/visualizations/")
+    session.log(f"  - Generated Docs: docs/build/generated_docs/")
+    session.log("=" * 60)
