diff --git a/dev-tools/configs/.pre-commit-config.yaml b/dev-tools/configs/.pre-commit-config.yaml
new file mode 100644
index 00000000..6ef955c9
--- /dev/null
+++ b/dev-tools/configs/.pre-commit-config.yaml
@@ -0,0 +1,92 @@
+repos:
+  # 🚀 Core Python Formatting & Linting
+  - repo: https://github.com/astral-sh/ruff-pre-commit
+    rev: v0.11.6
+    hooks:
+      - id: ruff
+        name: "Ruff Linter"
+        args: [--fix, --exit-non-zero-on-fix]
+      - id: ruff-format
+        name: "Ruff Formatter"
+
+  # 🧹 Code Cleanup
+  - repo: https://github.com/PyCQA/autoflake
+    rev: v2.3.1
+    hooks:
+      - id: autoflake
+        name: "Remove Unused Imports"
+        args:
+          - --remove-all-unused-imports
+          - --remove-unused-variables
+          - --in-place
+
+  # 🔧 Advanced Formatting
+  - repo: https://github.com/asottile/add-trailing-comma
+    rev: v3.2.0
+    hooks:
+      - id: add-trailing-comma
+        name: "Add Trailing Commas"
+        args: [--py39-plus]
+
+  - repo: https://github.com/asottile/pyupgrade
+    rev: v3.20.0
+    hooks:
+      - id: pyupgrade
+        name: "Modernize Python Syntax"
+        args: [--py312-plus]
+
+  # 📝 Docstring Formatting
+  - repo: https://github.com/PyCQA/docformatter
+    rev: v1.8.0
+    hooks:
+      - id: docformatter
+        name: "Format Docstrings"
+        args:
+          - --in-place
+          - --recursive
+
+  # 🔒 Security & Quality
+  - repo: https://github.com/PyCQA/bandit
+    rev: 1.8.0
+    hooks:
+      - id: bandit
+        name: "Security Check"
+        args: [-c, pyproject.toml]
+
+  # 📊 Type Checking (if using mypy)
+  - repo: https://github.com/pre-commit/mirrors-mypy
+    rev: v1.15.0
+    hooks:
+      - id: mypy
+        name: "Type Check"
+        additional_dependencies: [types-all]
+
+  # 🧾 Git Hooks
+  - repo: https://github.com/pre-commit/pre-commit-hooks
+    rev: v5.0.0
+    hooks:
+      - id: trailing-whitespace
+        name: "Remove Trailing Whitespace"
+      - id: end-of-file-fixer
+        name: "Fix End of Files"
+      - id: check-yaml
+        name: "Check YAML"
+      - id: check-toml
+        name: "Check TOML"
+      - id: check-merge-conflict
+        name: "Check Merge Conflicts"
+      - id: debug-statements
+        name: "Check Debug Statements"
+
+  # 🎯 Print Statement Elimination
+  - repo: local
+    hooks:
+      - id: no-print-statements
+        name: "No Print Statements"
+        entry: bash -c 'if grep -r "print(" --include="*.py" .; then echo "❌ Print statements found! Use logger instead."; exit 1; fi'
+        language: system
+        pass_filenames: false
+
+# 📋 Pre-commit Configuration
+default_stages: [commit]
+minimum_pre_commit_version: '3.0.0' 
\ No newline at end of file
