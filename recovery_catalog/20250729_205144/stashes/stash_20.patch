+#!/usr/bin/env python3
+"""Comprehensive Error Detection System for Haive Packages.
+
+This script scans all packages for various types of errors that could
+cause build failures, import issues, or other problems.
+"""
+
+import ast
+import logging
+import re
+import sys
+from pathlib import Path
+from typing import Dict, List, Set, Tuple
+
+# Set up logging
+logging.basicConfig(level=logging.INFO, format="%(levelname)s: %(message)s")
+logger = logging.getLogger(__name__)
+
+
+class ErrorDetector:
+    """Comprehensive error detection for Python packages."""
+
+    def __init__(self, packages_dir: Path):
+        self.packages_dir = packages_dir
+        self.errors = []
+        self.warnings = []
+
+    def detect_all_errors(self) -> Dict[str, List[str]]:
+        """Detect all types of errors across packages."""
+        logger.info("Starting comprehensive error detection...")
+
+        results = {
+            "syntax_errors": [],
+            "import_errors": [],
+            "naming_errors": [],
+            "unicode_errors": [],
+            "circular_imports": [],
+            "missing_files": [],
+            "invalid_structures": [],
+        }
+
+        # Get all Python files
+        python_files = list(self.packages_dir.rglob("*.py"))
+        logger.info(f"Found {len(python_files)} Python files to analyze")
+
+        for py_file in python_files:
+            try:
+                # Skip __pycache__ and .venv directories
+                if any(
+                    part.startswith(".") or part == "__pycache__"
+                    for part in py_file.parts
+                ):
+                    continue
+
+                # Check syntax errors
+                syntax_errors = self._check_syntax_errors(py_file)
+                if syntax_errors:
+                    results["syntax_errors"].extend(syntax_errors)
+
+                # Check import errors
+                import_errors = self._check_import_errors(py_file)
+                if import_errors:
+                    results["import_errors"].extend(import_errors)
+
+                # Check naming conventions
+                naming_errors = self._check_naming_conventions(py_file)
+                if naming_errors:
+                    results["naming_errors"].extend(naming_errors)
+
+                # Check Unicode issues
+                unicode_errors = self._check_unicode_issues(py_file)
+                if unicode_errors:
+                    results["unicode_errors"].extend(unicode_errors)
+
+            except Exception as e:
+                logger.error(f"Error processing {py_file}: {e}")
+                results["invalid_structures"].append(f"{py_file}: {e}")
+
+        # Check for missing __init__.py files
+        missing_files = self._check_missing_init_files()
+        results["missing_files"].extend(missing_files)
+
+        # Check for circular imports (basic detection)
+        circular_imports = self._detect_basic_circular_imports(python_files)
+        results["circular_imports"].extend(circular_imports)
+
+        return results
+
+    def _check_syntax_errors(self, py_file: Path) -> List[str]:
+        """Check for Python syntax errors."""
+        errors = []
+
+        try:
+            with open(py_file, "r", encoding="utf-8") as f:
+                content = f.read()
+
+            # Try to parse with AST
+            try:
+                ast.parse(content, filename=str(py_file))
+            except SyntaxError as e:
+                errors.append(f"SYNTAX ERROR in {py_file}:{e.lineno}: {e.msg}")
+            except Exception as e:
+                errors.append(f"PARSE ERROR in {py_file}: {e}")
+
+        except UnicodeDecodeError as e:
+            errors.append(f"ENCODING ERROR in {py_file}: {e}")
+        except Exception as e:
+            errors.append(f"FILE READ ERROR in {py_file}: {e}")
+
+        return errors
+
+    def _check_import_errors(self, py_file: Path) -> List[str]:
+        """Check for import-related errors."""
+        errors = []
+
+        try:
+            with open(py_file, "r", encoding="utf-8") as f:
+                content = f.read()
+
+            # Check for invalid module names in imports
+            import_patterns = [
+                r"from\s+([^\s]+)\s+import",
+                r"import\s+([^\s,\n]+)",
+            ]
+
+            for i, line in enumerate(content.splitlines(), 1):
+                for pattern in import_patterns:
+                    matches = re.findall(pattern, line)
+                    for match in matches:
+                        # Check for hyphens in module names
+                        if "-" in match and not match.startswith("."):
+                            errors.append(
+                                f"INVALID MODULE NAME in {py_file}:{i}: '{match}' contains hyphens"
+                            )
+
+                        # Check for invalid relative imports
+                        if match.startswith("..") and match.count(".") > 2:
+                            errors.append(
+                                f"SUSPICIOUS RELATIVE IMPORT in {py_file}:{i}: '{match}'"
+                            )
+
+        except Exception as e:
+            errors.append(f"IMPORT CHECK ERROR in {py_file}: {e}")
+
+        return errors
+
+    def _check_naming_conventions(self, py_file: Path) -> List[str]:
+        """Check file and directory naming conventions."""
+        errors = []
+
+        # Check if filename contains hyphens (invalid for Python modules)
+        if "-" in py_file.stem and py_file.suffix == ".py":
+            errors.append(
+                f"INVALID FILENAME: {py_file} contains hyphens (not importable)"
+            )
+
+        # Check parent directories for hyphens in package structure
+        for parent in py_file.parents:
+            if parent.name and "-" in parent.name and not parent.name.startswith("."):
+                # Allow hyphens in top-level package names like haive-core
+                if parent.parent.name != "packages":
+                    errors.append(f"INVALID DIRECTORY NAME: {parent} contains hyphens")
+
+        return errors
+
+    def _check_unicode_issues(self, py_file: Path) -> List[str]:
+        """Check for Unicode and string formatting issues."""
+        errors = []
+
+        try:
+            with open(py_file, "r", encoding="utf-8") as f:
+                content = f.read()
+
+            lines = content.splitlines()
+            for i, line in enumerate(lines, 1):
+                # Check for malformed Unicode strings
+                if "🏛️" in line:
+                    # Look for patterns like "text"* emoji" which are syntax errors
+                    if re.search(r'"[^"]*"\s*\*\s*🏛️', line):
+                        errors.append(
+                            f"MALFORMED UNICODE STRING in {py_file}:{i}: {line.strip()}"
+                        )
+
+                # Check for unescaped backslashes in strings
+                if "\\" in line and not line.strip().startswith("#"):
+                    # Look for potential escape sequence issues
+                    string_matches = re.findall(r'["\']([^"\']*\\[^"\']*)["\']', line)
+                    for match in string_matches:
+                        if "\\" in match and not any(
+                            seq in match
+                            for seq in ["\\n", "\\t", "\\r", '\\"', "\\'", "\\\\"]
+                        ):
+                            errors.append(
+                                f"POTENTIAL ESCAPE SEQUENCE ISSUE in {py_file}:{i}: {line.strip()}"
+                            )
+
+        except Exception as e:
+            errors.append(f"UNICODE CHECK ERROR in {py_file}: {e}")
+
+        return errors
+
+    def _check_missing_init_files(self) -> List[str]:
+        """Check for missing __init__.py files in package directories."""
+        errors = []
+
+        # Find all directories that contain Python files
+        python_dirs = set()
+        for py_file in self.packages_dir.rglob("*.py"):
+            python_dirs.add(py_file.parent)
+
+        for py_dir in python_dirs:
+            # Skip if it's in __pycache__ or .venv
+            if any(
+                part.startswith(".") or part == "__pycache__" for part in py_dir.parts
+            ):
+                continue
+
+            # Check if __init__.py exists
+            init_file = py_dir / "__init__.py"
+            if not init_file.exists():
+                # Check if this directory has Python files that would be imported
+                py_files = list(py_dir.glob("*.py"))
+                if py_files:
+                    errors.append(f"MISSING __init__.py in {py_dir}")
+
+        return errors
+
+    def _detect_basic_circular_imports(self, python_files: List[Path]) -> List[str]:
+        """Detect basic circular import patterns."""
+        errors = []
+
+        # Build import graph
+        import_graph = {}
+
+        for py_file in python_files:
+            try:
+                with open(py_file, "r", encoding="utf-8") as f:
+                    content = f.read()
+
+                # Extract imports
+                imports = []
+                for line in content.splitlines():
+                    if line.strip().startswith(("import ", "from ")):
+                        imports.append(line.strip())
+
+                module_name = self._get_module_name(py_file)
+                if module_name:
+                    import_graph[module_name] = imports
+
+            except Exception:
+                continue
+
+        # Simple circular import detection (A imports B, B imports A)
+        for module, imports in import_graph.items():
+            for import_line in imports:
+                # Extract imported module name
+                if import_line.startswith("from "):
+                    match = re.match(r"from\s+([^\s]+)\s+import", import_line)
+                    if match:
+                        imported_module = match.group(1)
+                        # Check if imported module imports this module back
+                        if imported_module in import_graph:
+                            for other_import in import_graph[imported_module]:
+                                if module in other_import:
+                                    errors.append(
+                                        f"POTENTIAL CIRCULAR IMPORT: {module} ↔ {imported_module}"
+                                    )
+
+        return errors
+
+    def _get_module_name(self, py_file: Path) -> str:
+        """Get the module name for a Python file."""
+        try:
+            # Get relative path from packages directory
+            relative_path = py_file.relative_to(self.packages_dir)
+
+            # Convert to module name
+            parts = list(relative_path.parts)
+            if parts[-1] == "__init__.py":
+                parts = parts[:-1]
+            else:
+                parts[-1] = parts[-1].replace(".py", "")
+
+            return ".".join(parts)
+        except:
+            return ""
+
+    def generate_report(self, results: Dict[str, List[str]]) -> str:
+        """Generate a comprehensive error report."""
+        report_lines = ["🚨 COMPREHENSIVE ERROR DETECTION REPORT 🚨", "=" * 50, ""]
+
+        total_errors = sum(len(errors) for errors in results.values())
+
+        if total_errors == 0:
+            report_lines.extend(
+                ["✅ NO ERRORS DETECTED!", "All packages appear to be error-free.", ""]
+            )
+        else:
+            report_lines.extend([f"📊 SUMMARY: {total_errors} total issues found", ""])
+
+            for category, errors in results.items():
+                if errors:
+                    report_lines.extend(
+                        [
+                            f"🔍 {category.upper().replace('_', ' ')} ({len(errors)} issues):",
+                            "-" * 40,
+                        ]
+                    )
+
+                    for error in errors:
+                        report_lines.append(f"  • {error}")
+
+                    report_lines.append("")
+
+        # Add recommendations
+        report_lines.extend(
+            [
+                "🛠️  RECOMMENDED ACTIONS:",
+                "-" * 30,
+                "1. Fix syntax errors first (they prevent parsing)",
+                "2. Rename files with hyphens to use underscores",
+                "3. Fix import statements to use valid module names",
+                "4. Add missing __init__.py files where needed",
+                "5. Resolve Unicode string formatting issues",
+                "6. Review and resolve circular imports",
+                "",
+            ]
+        )
+
+        return "\n".join(report_lines)
+
+    def save_report(self, results: Dict[str, List[str]], output_file: Path) -> None:
+        """Save the error report to a file."""
+        report = self.generate_report(results)
+
+        with open(output_file, "w", encoding="utf-8") as f:
+            f.write(report)
+
+        logger.info(f"Error report saved to: {output_file}")
+
+
+def main():
+    """Main execution function."""
+    # Get packages directory
+    script_dir = Path(__file__).parent
+    packages_dir = script_dir.parent / "packages"
+
+    if not packages_dir.exists():
+        logger.error(f"Packages directory not found: {packages_dir}")
+        sys.exit(1)
+
+    # Create error detector
+    detector = ErrorDetector(packages_dir)
+
+    # Detect all errors
+    logger.info("Starting comprehensive error detection...")
+    results = detector.detect_all_errors()
+
+    # Generate report
+    report = detector.generate_report(results)
+    print(report)
+
+    # Save report
+    output_file = script_dir.parent / "comprehensive_error_report.txt"
+    detector.save_report(results, output_file)
+
+    # Exit with error code if issues found
+    total_errors = sum(len(errors) for errors in results.values())
+    if total_errors > 0:
+        logger.error(f"Found {total_errors} issues that need attention")
+        sys.exit(1)
+    else:
+        logger.info("✅ No errors detected!")
+        sys.exit(0)
+
+
+if __name__ == "__main__":
+    main()
