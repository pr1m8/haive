+#!/usr/bin/env python3
+"""Comprehensive automated fix using all our dev dependencies.
+
+This uses trunk, ruff, black, isort, and custom logic to fix:
+1. Import issues (relative vs absolute)
+2. Syntax errors (regex patterns, quotes, etc.)
+3. Code formatting
+4. Common Python issues
+"""
+
+import ast
+import re
+import subprocess
+import sys
+from pathlib import Path
+from typing import Dict, List, Tuple
+
+
+class DevToolsFixer:
+    """Use all available dev tools to fix issues."""
+
+    def __init__(self, base_dir: Path):
+        self.base_dir = base_dir
+        self.packages = [
+            "haive-core",
+            "haive-agents",
+            "haive-games",
+            "haive-tools",
+            "haive-mcp",
+        ]
+        self.results = {
+            "trunk_fixes": 0,
+            "ruff_fixes": 0,
+            "syntax_fixes": 0,
+            "import_fixes": 0,
+            "black_formatted": 0,
+            "total_files": 0,
+            "still_broken": [],
+        }
+
+    def run_comprehensive_fix(self):
+        """Run all fixes in the optimal order."""
+
+        # Step 1: Fix basic syntax errors first
+        self.fix_basic_syntax_errors()
+
+        # Step 2: Run ruff to fix many issues automatically
+        self.run_ruff_fixes()
+
+        # Step 3: Fix import issues
+        self.fix_import_issues()
+
+        # Step 4: Format with black
+        self.run_black_formatting()
+
+        # Step 5: Organize imports with isort
+        self.run_isort()
+
+        # Step 6: Run trunk check for final cleanup
+        self.run_trunk_check()
+
+        # Step 7: Validate results
+        self.validate_results()
+
+        self.print_summary()
+
+    def fix_basic_syntax_errors(self):
+        """Fix basic syntax errors that prevent parsing."""
+        for package in self.packages:
+            package_dir = self.base_dir / "packages" / package / "src"
+            if not package_dir.exists():
+                continue
+
+            py_files = list(package_dir.rglob("*.py"))
+
+            for py_file in py_files:
+                if self._should_skip_file(py_file):
+                    continue
+
+                self.results["total_files"] += 1
+                if self._fix_syntax_errors(py_file):
+                    self.results["syntax_fixes"] += 1
+
+    def _should_skip_file(self, file_path: Path) -> bool:
+        """Skip certain files."""
+        skip_patterns = [
+            ".ipynb_checkpoints",
+            "__pycache__",
+            "test_",
+            "_test.py",
+            "temp_",
+            "fix_",
+        ]
+        return any(pattern in str(file_path) for pattern in skip_patterns)
+
+    def _fix_syntax_errors(self, file_path: Path) -> bool:
+        """Fix common syntax errors in a file."""
+        try:
+            content = file_path.read_text(encoding="utf-8")
+            original_content = content
+
+            # Fix common regex pattern issues
+            fixes = [
+                # Fix unterminated strings with regex
+                (r'"""([^"]*\\[ws]\+[^"]*)"""', r'"""\\1"""'),
+                (r'"([^"]*\\[ws]\+[^"]*)"', r'"\\1"'),
+                # Fix arrow characters
+                (r"→", "->"),
+                # Fix incomplete function calls
+                (r"(\w+)\(\s*$", r"\\1()"),
+                # Fix missing closing quotes
+                (r'"""([^"]*?)$', r'"""\\1"""'),
+                # Fix invalid escape sequences
+                (r"\\([ws])\+", r"\\\\\\1+"),
+                # Fix incomplete imports
+                (r"from\s+(\w+)\s*$", r"from \\1 import"),
+            ]
+
+            for pattern, replacement in fixes:
+                content = re.sub(
+                    pattern, replacement, content, flags=re.MULTILINE | re.DOTALL
+                )
+
+            # Test if it's valid Python now
+            try:
+                ast.parse(content)
+                if content != original_content:
+                    file_path.write_text(content, encoding="utf-8")
+                    return True
+            except SyntaxError:
+                # If still broken, revert
+                if content != original_content:
+                    file_path.write_text(original_content, encoding="utf-8")
+
+        except Exception as e:
+            pass")
+
+        return False
+
+    def run_ruff_fixes(self):
+        """Run ruff to auto-fix many issues."""
+        for package in self.packages:
+            package_dir = self.base_dir / "packages" / package
+            if not package_dir.exists():
+                continue
+
+            try:
+                result = subprocess.run(
+                    [
+                        "poetry",
+                        "run",
+                        "ruff",
+                        "check",
+                        str(package_dir / "src"),
+                        "--fix",
+                        "--unsafe-fixes",
+                    ],
+                    check=False, cwd=self.base_dir,
+                    capture_output=True,
+                    text=True,
+                )
+
+                if "fixed" in result.stdout.lower():
+                    self.results["ruff_fixes"] += 1
+
+            except Exception as e:
+                pass")
+
+    def fix_import_issues(self):
+        """Fix common import issues."""
+        for package in self.packages:
+            package_dir = self.base_dir / "packages" / package / "src"
+            if not package_dir.exists():
+                continue
+
+            # Fix common import patterns
+            for py_file in package_dir.rglob("*.py"):
+                if self._should_skip_file(py_file):
+                    continue
+
+                if self._fix_imports(py_file, package):
+                    self.results["import_fixes"] += 1
+
+    def _fix_imports(self, file_path: Path, package: str) -> bool:
+        """Fix imports in a specific file."""
+        try:
+            content = file_path.read_text(encoding="utf-8")
+            original_content = content
+
+            # Package-specific import fixes
+            if package == "haive-core":
+                # Fix config and persistence circular imports
+                content = re.sub(
+                    r"^from (config|persistence)\.(\w+)",
+                    r"from .\\2",
+                    content,
+                    flags=re.MULTILINE,
+                )
+
+                # Fix absolute imports within core
+                content = re.sub(
+                    r"^from haive\.core\.(config|persistence)\.(\w+)",
+                    r"from .\\2",
+                    content,
+                    flags=re.MULTILINE,
+                )
+
+            # General fixes for all packages
+            content = re.sub(
+                r"^from haive\.(\w+)\.src\.haive\.\\1\.",
+                r"from .",
+                content,
+                flags=re.MULTILINE,
+            )
+
+            if content != original_content:
+                file_path.write_text(content, encoding="utf-8")
+                return True
+
+        except Exception as e:
+            pass")
+
+        return False
+
+    def run_black_formatting(self):
+        """Run black to format code."""
+        for package in self.packages:
+            package_dir = self.base_dir / "packages" / package / "src"
+            if not package_dir.exists():
+                continue
+
+            try:
+                result = subprocess.run(
+                    [
+                        "poetry",
+                        "run",
+                        "black",
+                        str(package_dir),
+                        "--line-length",
+                        "88",
+                        "--skip-string-normalization",
+                    ],
+                    check=False, cwd=self.base_dir,
+                    capture_output=True,
+                    text=True,
+                )
+
+                if "reformatted" in result.stdout:
+                    self.results["black_formatted"] += 1
+
+            except Exception as e:
+                pass")
+
+    def run_isort(self):
+        """Run isort to organize imports."""
+        for package in self.packages:
+            package_dir = self.base_dir / "packages" / package / "src"
+            if not package_dir.exists():
+                continue
+
+            try:
+                subprocess.run(
+                    [
+                        "poetry",
+                        "run",
+                        "isort",
+                        str(package_dir),
+                        "--profile",
+                        "black",
+                        "--line-length",
+                        "88",
+                    ],
+                    check=False, cwd=self.base_dir,
+                    capture_output=True,
+                    text=True,
+                )
+
+
+            except Exception as e:
+                pass")
+
+    def run_trunk_check(self):
+        """Run trunk check for final validation."""
+        try:
+            result = subprocess.run(
+                ["trunk", "check", "--fix", "--all"],
+                check=False, cwd=self.base_dir,
+                capture_output=True,
+                text=True,
+            )
+
+            if result.returncode == 0:
+                self.results["trunk_fixes"] += 1
+            else:
+                pass..")
+
+        except Exception as e:
+            pass")
+
+    def validate_results(self):
+        """Validate that files can be imported."""
+
+        test_imports = [
+            "haive.core.config",
+            "haive.core.persistence",
+            "haive.agents.simple",
