+#!/usr/bin/env python3
+"""
+Comprehensive syntax error finder and fixer.
+This script will:
+1. Find ALL files with syntax errors
+2. Attempt automatic fixes for common patterns
+3. Report unfixable issues for manual review
+"""
+
+import ast
+import os
+import re
+import subprocess
+from pathlib import Path
+from typing import Dict, List, Tuple
+
+
+def check_python_syntax(file_path: str) -> Tuple[bool, str]:
+    """Check if a Python file has valid syntax."""
+    try:
+        with open(file_path, "r", encoding="utf-8") as f:
+            content = f.read()
+        ast.parse(content)
+        return True, "OK"
+    except SyntaxError as e:
+        return False, f"SyntaxError: {e}"
+    except Exception as e:
+        return False, f"Other error: {e}"
+
+
+def fix_common_regex_patterns(content: str) -> str:
+    """Fix common regex patterns that cause syntax errors."""
+    fixes = [
+        # Basic regex escapes that shouldn't be there
+        (r"\\s\+", " "),
+        (r"\\w\+", ""),
+        (r"\\d\+", ""),
+        (r"\\n\+", ""),
+        (r"\\t\+", ""),
+        # Fix field definitions
+        (r"\\s\+nam\\w\+=", "name="),
+        (r"\\s\+descriptio\\w\+=", "description="),
+        (r"\\s\+conten\\w\+=", "content="),
+        # Fix class names
+        (r"AgentConfi\\w\+", "AgentConfig"),
+        (r"BaseMode\\w\+", "BaseModel"),
+        (r"Tru\\w\+", "True"),
+        (r"lambd\\w\+", "lambda"),
+        (r"ValueErro\\w\+", "ValueError"),
+        (r"field_validato\\w\+", "field_validator"),
+        (r"prin\\w\+", "print"),
+        (r"mai\\w\+", "main"),
+        (r"__name_\\w\+", "__name__"),
+        (r"confi\\w\+", "config"),
+        (r"kwarg\\w\+", "kwargs"),
+        (r"An\\w\+", "Any"),
+        # Fix numeric patterns
+        (r"2\\w\+\.\\d\+", "25.0"),
+        (r"5\\w\+\.\\d\+", "50.0"),
+        (r"7\\w\+\.\\d\+", "75.0"),
+        (r"90\.\\d\+", "90.0"),
+        (r"40\.\\d\+", "40.0"),
+        (r"\\w\+\.\\d\+", "2.0"),
+        (r"10\\d\+", "100"),
+        (r"le=\\d\+", "le=10"),
+        # Fix variable patterns
+        (r"v\.ge\\w\+", "v.get"),
+        (r"compliance_check\\w\+=", "compliance_checks="),
+        (r"variable_nam\\w\+=", "variable_name="),
+        # Fix string issues
+        (r'"\\s\+', '"'),
+        (r'\\s\+"', '"'),
+        (r'"\\w\+', '"'),
+        (r'\\w\+"', '"'),
+        # Fix print statements with regex
+        (r'print\("([^"]*)"([^"]*)"([^"]*)"\)', r'print("\1\3")'),
+        # Fix datetime format
+        (r"'%Y%m%d_%H%M%\\w\+'", "'%Y%m%d_%H%M%S'"),
+        # Fix statements
+        (r"if\\s\+", "if "),
+        (r"or\\s\+", "or "),
+        (r"raise\\s\+", "raise "),
+        # Fix unclosed strings with regex
+        (r'(["\'])([^"\']*\\[sw]\+[^"\']*)\1', r"\1\2\1"),
+        # Fix __all__ lists with regex
+        (r"__all__ = \[([^\]]*\\[sw]\+[^\]]*)\]", r"__all__ = []"),
+        # Fix incomplete function calls
+        (r"(\w+)\(\s*$", r"\1()"),
+        # Fix malformed dictionary entries
+        (r"{\s*([^}]*\\[sw]\+[^}]*)\s*}", r"{}"),
+    ]
+
+    for pattern, replacement in fixes:
+        content = re.sub(pattern, replacement, content)
+
+    return content
+
+
+def fix_indentation_issues(content: str) -> str:
+    """Fix common indentation issues."""
+    lines = content.split("\n")
+    fixed_lines = []
+    current_indent = 0
+
+    for line in lines:
+        stripped = line.strip()
+
+        # Skip empty lines
+        if not stripped:
+            fixed_lines.append("")
+            continue
+
+        # Calculate expected indentation based on context
+        if stripped.startswith("class ") or stripped.startswith("def "):
+            current_indent = 0
+        elif stripped.startswith(("if ", "for ", "while ", "with ", "try:")):
+            # These increase indentation for next line
+            pass
+        elif stripped.startswith(("except", "finally", "else", "elif")):
+            # These should be at same level as their parent
+            pass
+        elif stripped.startswith(('"', "'")):
+            # Docstrings should be indented
+            pass
+
+        # Apply consistent 4-space indentation
+        if line.startswith(" ") and not line.startswith("    "):
+            # Fix inconsistent indentation
+            leading_spaces = len(line) - len(line.lstrip())
+            if leading_spaces > 0:
+                # Convert to 4-space indentation
+                indent_level = (
+                    leading_spaces + 2
+                ) // 4  # Round to nearest 4-space level
+                fixed_line = "    " * indent_level + stripped
+                fixed_lines.append(fixed_line)
+            else:
+                fixed_lines.append(line)
+        else:
+            fixed_lines.append(line)
+
+    return "\n".join(fixed_lines)
+
+
+def run_autopep8_fix(file_path: str) -> bool:
+    """Run autopep8 to fix the file."""
+    try:
+        result = subprocess.run(
+            [
+                "python",
+                "-m",
+                "autopep8",
+                "--in-place",
+                "--aggressive",
+                "--aggressive",
+                "--max-line-length=100",
+                file_path,
+            ],
+            capture_output=True,
+            text=True,
+        )
+        return result.returncode == 0
+    except:
+        return False
+
+
+def find_and_fix_all_syntax_errors():
+    """Find and fix all syntax errors in the packages."""
+
+    base_dir = Path("/home/will/Projects/haive/backend/haive")
+
+    # Find all Python files
+    python_files = []
+    for package_dir in [
+        "packages/haive-core/src",
+        "packages/haive-agents/src",
+        "packages/haive-tools/src",
+        "packages/haive-games/src",
+        "packages/haive-prebuilt/src",
+        "packages/haive-mcp/src",
+    ]:
+        package_path = base_dir / package_dir
+        if package_path.exists():
+            python_files.extend(package_path.rglob("*.py"))
+
+    print(f"Found {len(python_files)} Python files to check...")
+
+    syntax_errors = []
+    fixed_count = 0
+
+    for py_file in python_files:
+        file_path_str = str(py_file)
+
+        # Check initial syntax
+        is_valid, error_msg = check_python_syntax(file_path_str)
+
+        if not is_valid:
+            print(f"❌ Syntax error: {py_file.relative_to(base_dir)}")
+            print(f"   Error: {error_msg}")
+
+            try:
+                # Try to fix it
+                with open(file_path_str, "r", encoding="utf-8") as f:
+                    original_content = f.read()
+
+                # Apply regex fixes
+                fixed_content = fix_common_regex_patterns(original_content)
+
+                # Apply indentation fixes
+                fixed_content = fix_indentation_issues(fixed_content)
+
+                # Write the fixed content
+                with open(file_path_str, "w", encoding="utf-8") as f:
+                    f.write(fixed_content)
+
+                # Run autopep8 for additional fixes
+                run_autopep8_fix(file_path_str)
+
+                # Check if fixed
+                is_fixed, _ = check_python_syntax(file_path_str)
+
+                if is_fixed:
+                    print(f"✅ Fixed: {py_file.relative_to(base_dir)}")
+                    fixed_count += 1
+                else:
+                    print(f"⚠️  Partially fixed: {py_file.relative_to(base_dir)}")
+                    syntax_errors.append((py_file, error_msg))
+
+            except Exception as e:
+                print(f"💥 Failed to fix: {py_file.relative_to(base_dir)} - {e}")
+                syntax_errors.append((py_file, f"Fix failed: {e}"))
+
+    print(f"\n📊 Summary:")
+    print(f"  Total files checked: {len(python_files)}")
+    print(f"  Files fixed: {fixed_count}")
+    print(f"  Files still with errors: {len(syntax_errors)}")
+
+    if syntax_errors:
+        print(f"\n🚨 Files that still need manual fixing:")
+        for file_path, error in syntax_errors[:10]:  # Show first 10
+            print(f"  {file_path.relative_to(base_dir)}: {error}")
+
+        if len(syntax_errors) > 10:
+            print(f"  ... and {len(syntax_errors) - 10} more files")
+
+    return syntax_errors
+
+
+if __name__ == "__main__":
+    find_and_fix_all_syntax_errors()
