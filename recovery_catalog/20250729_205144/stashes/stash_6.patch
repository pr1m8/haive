+# ==============================================================================
+# Additional Extension Configurations
+# ==============================================================================
+
+# === AUTODOCSUMM - Module summaries ===
+autodocsumm_generate_autosummary_docs = True
+
+# === SPHINX CONTRIBUTORS ===
+sphinx_contributors_exclude_contributors = []
+sphinx_contributors_exclude_maintainers = []
+
+# === SPHINX FAVICON ===
+favicons = [
+    {"rel": "icon", "sizes": "16x16", "href": "favicon-16x16.png"},
+    {"rel": "icon", "sizes": "32x32", "href": "favicon-32x32.png"},
+]
+
+# === SPHINX ISSUES - GitHub integration ===
+issues_github_path = "will-astley/haive"
+issues_pr_uri = "https://github.com/will-astley/haive/pull/{issue}"
+issues_issue_uri = "https://github.com/will-astley/haive/issues/{issue}"
+
+# === HOVER XREF - Tooltips ===
+hoverxref_auto_ref = True
+hoverxref_domains = ["py", "c", "cpp"]
+hoverxref_roles = ["ref", "class", "func", "meth", "attr", "exc", "obj"]
+hoverxref_role_types = {
+    "ref": "tooltip",
+    "class": "modal",
+    "func": "tooltip",
+    "meth": "tooltip",
+}
+
+# === SPHINX MATH DOLLAR ===
+math_dollar_debug = False
+
+# === SPHINX PYPROJECT - Read from pyproject.toml ===
+pyproject_use = True
+
+# === SPHINX THEBE - Live code execution ===
+thebe_config = {
+    "repository_url": "https://github.com/will-astley/haive",
+    "repository_branch": "main",
+}
+
+# === SPHINX TIPPY - Tooltips ===
+tippy_js_setup = {
+    "theme": "material",
+    "placement": "auto",
+    "animation": "scale",
+}
+
+# === SPHINXCONTRIB IMAGES ===
+images_config = {
+    "download": True,
+    "backend": "LightBox2",
+    "lightbox2_slideshowSpeed": 5000,
+}
+
+# === SPHINXEMOJI ===
+sphinxemoji_style = "twemoji"
+
