+if [[ "${errors}" -eq 0 ]]; then
+	echo "✅ All rich dependencies are consistent at version ${expected_version}"
 	exit 0
 else
-	echo "❌ Found $errors inconsistent rich dependencies"
+	echo "❌ Found ${errors} inconsistent rich dependencies"
 	echo "💡 Run: ./dev-tools/scripts/fix-rich-dependency-permanently.sh"
 	exit 1
 fi
