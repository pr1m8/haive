+@nox.session(python=PYTHON_VERSIONS)
+def docs_view(session):
+    """Open the built documentation in your browser."""
+    import webbrowser
+    import os
+    from datetime import datetime
+    
+    index_path = BUILD_DIR / "html" / "index.html"
+    
+    if not index_path.exists():
+        session.error(f"Documentation not found at {index_path}")
+        session.log("Run 'poetry run nox -s docs' to build documentation first")
+        return
+    
+    # Get last modified time
+    mtime = os.path.getmtime(index_path)
+    last_built = datetime.fromtimestamp(mtime).strftime("%Y-%m-%d %H:%M:%S")
+    
+    session.log(f"Opening documentation (last built: {last_built})")
+    session.log(f"Location: {index_path}")
+    
+    # Open in browser
+    file_url = f"file://{index_path.absolute()}"
+    webbrowser.open(file_url)
+    session.log("Documentation opened in browser")
+
+
