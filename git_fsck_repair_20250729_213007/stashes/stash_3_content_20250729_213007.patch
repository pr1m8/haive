@@ -0,0 +1,246 @@
+name: 🔄 Safe Refactoring Workflow
+
+on:
+  workflow_dispatch:
+    inputs:
+      operation:
+        description: 'Refactoring operation to perform'
+        required: true
+        default: 'check-safety'
+        type: choice
+        options:
+          - check-safety
+          - find-usages
+          - rename-function
+          - rename-variable
+          - extract-method
+      
+      old_name:
+        description: 'Old symbol name (for rename operations)'
+        required: false
+        type: string
+      
+      new_name:
+        description: 'New symbol name (for rename operations)'
+        required: false
+        type: string
+      
+      target_directory:
+        description: 'Target directory (default: src/)'
+        required: false
+        default: 'src/'
+        type: string
+      
+      file_path:
+        description: 'File path (for extract-method)'
+        required: false
+        type: string
+      
+      start_line:
+        description: 'Start line (for extract-method)'
+        required: false
+        type: string
+      
+      end_line:
+        description: 'End line (for extract-method)'
+        required: false
+        type: string
+
+  pull_request:
+    paths:
+      - '**/*.py'
+    types: [opened, synchronize]
+
+jobs:
+  safety-check:
+    name: 🔍 Safety Check
+    runs-on: ubuntu-latest
+    if: github.event_name == 'pull_request' || github.event.inputs.operation == 'check-safety'
+    
+    steps:
+      - name: 📥 Checkout Code
+        uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+      
+      - name: 🐍 Setup Python
+        uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+      
+      - name: 📦 Install Poetry
+        uses: snok/install-poetry@v1
+        with:
+          version: latest
+          virtualenvs-create: true
+          virtualenvs-in-project: true
+      
+      - name: 🔧 Install Dependencies
+        run: |
+          poetry install --only dev
+          poetry add --group dev rope bowler
+      
+      - name: 🔍 Run Safety Check
+        run: |
+          chmod +x dev-tools/scripts/safe-refactor.sh
+          ./dev-tools/scripts/safe-refactor.sh check-safety ${{ github.event.inputs.target_directory || 'src/' }}
+      
+      - name: 📊 Syntax Validation
+        run: |
+          echo "🔍 Running comprehensive syntax check..."
+          find . -name "*.py" -path "./packages/*" -exec python -m py_compile {} \;
+          echo "✅ All Python files have valid syntax"
+
+  refactoring-operation:
+    name: 🔄 Refactoring Operation
+    runs-on: ubuntu-latest
+    if: github.event_name == 'workflow_dispatch' && github.event.inputs.operation != 'check-safety'
+    
+    steps:
+      - name: 📥 Checkout Code
+        uses: actions/checkout@v4
+        with:
+          token: ${{ secrets.GITHUB_TOKEN }}
+          fetch-depth: 0
+      
+      - name: 🐍 Setup Python
+        uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+      
+      - name: 📦 Install Poetry
+        uses: snok/install-poetry@v1
+        with:
+          version: latest
+          virtualenvs-create: true
+          virtualenvs-in-project: true
+      
+      - name: 🔧 Install Dependencies
+        run: |
+          poetry install --only dev
+          poetry add --group dev rope bowler
+      
+      - name: 🛡️ Create Safety Backup
+        run: |
+          git config --local user.email "action@github.com"
+          git config --local user.name "GitHub Action"
+          git stash push -m "AUTOMATED_REFACTOR_BACKUP_$(date +%Y%m%d_%H%M%S)"
+      
+      - name: 🔄 Execute Refactoring
+        run: |
+          chmod +x dev-tools/scripts/safe-refactor.sh
+          
+          case "${{ github.event.inputs.operation }}" in
+            "rename-function")
+              ./dev-tools/scripts/safe-refactor.sh rename-function \
+                "${{ github.event.inputs.old_name }}" \
+                "${{ github.event.inputs.new_name }}" \
+                "${{ github.event.inputs.target_directory }}"
+              ;;
+            "rename-variable")
+              ./dev-tools/scripts/safe-refactor.sh rename-variable \
+                "${{ github.event.inputs.old_name }}" \
+                "${{ github.event.inputs.new_name }}" \
+                "${{ github.event.inputs.target_directory }}"
+              ;;
+            "extract-method")
+              ./dev-tools/scripts/safe-refactor.sh extract-method \
+                "${{ github.event.inputs.file_path }}" \
+                "${{ github.event.inputs.start_line }}" \
+                "${{ github.event.inputs.end_line }}" \
+                "${{ github.event.inputs.new_name }}"
+              ;;
+            "find-usages")
+              ./dev-tools/scripts/safe-refactor.sh find-usages \
+                "${{ github.event.inputs.old_name }}" \
+                "${{ github.event.inputs.target_directory }}"
+              ;;
+          esac
+      
+      - name: 🔍 Post-Refactor Safety Check
+        run: |
+          echo "🔍 Verifying refactoring safety..."
+          ./dev-tools/scripts/safe-refactor.sh check-safety
+          
+          echo "🧪 Running basic tests..."
+          # Add your test command here, e.g.:
+          # poetry run pytest tests/ -x --tb=short
+      
+      - name: 📝 Commit Changes
+        if: success()
+        run: |
+          git add .
+          if git diff --staged --quiet; then
+            echo "No changes to commit"
+          else
+            git commit -m "🔄 Automated refactoring: ${{ github.event.inputs.operation }}
+            
+            Operation: ${{ github.event.inputs.operation }}
+            Old name: ${{ github.event.inputs.old_name }}
+            New name: ${{ github.event.inputs.new_name }}
+            Directory: ${{ github.event.inputs.target_directory }}
+            
+            Generated by GitHub Actions workflow"
+            
+            git push
+          fi
+      
+      - name: 📊 Generate Refactoring Report
+        if: always()
+        run: |
+          echo "# 🔄 Refactoring Report" > refactoring-report.md
+          echo "" >> refactoring-report.md
+          echo "**Operation:** ${{ github.event.inputs.operation }}" >> refactoring-report.md
+          echo "**Target:** ${{ github.event.inputs.target_directory }}" >> refactoring-report.md
+          echo "**Status:** ${{ job.status }}" >> refactoring-report.md
+          echo "" >> refactoring-report.md
+          
+          if [ "${{ github.event.inputs.operation }}" = "find-usages" ]; then
+            echo "## 🔍 Usage Results" >> refactoring-report.md
+            echo "\`\`\`" >> refactoring-report.md
+            ./dev-tools/scripts/safe-refactor.sh find-usages \
+              "${{ github.event.inputs.old_name }}" \
+              "${{ github.event.inputs.target_directory }}" >> refactoring-report.md || true
+            echo "\`\`\`" >> refactoring-report.md
+          fi
+      
+      - name: 📎 Upload Report
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: refactoring-report
+          path: refactoring-report.md
+
+  lint-after-refactor:
+    name: 🧹 Lint After Refactor
+    runs-on: ubuntu-latest
+    needs: [refactoring-operation]
+    if: always() && needs.refactoring-operation.result == 'success'
+    
+    steps:
+      - name: 📥 Checkout Code
+        uses: actions/checkout@v4
+      
+      - name: 🐍 Setup Python
+        uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+      
+      - name: 📦 Install Poetry
+        uses: snok/install-poetry@v1
+      
+      - name: 🔧 Install Dependencies
+        run: poetry install --only dev
+      
+      - name: 🧹 Run Automated Cleanup
+        run: |
+          chmod +x dev-tools/scripts/bulk_package_fix.sh
+          # Run the proven cleanup methodology
+          ./dev-tools/scripts/bulk_package_fix.sh haive-games || true
+          ./dev-tools/scripts/bulk_package_fix.sh haive-dataflow || true
+          ./dev-tools/scripts/bulk_package_fix.sh haive-mcp || true
+      
+      - name: 📊 Final Health Check
+        run: |
+          chmod +x dev-tools/scripts/monitor-progress.sh
+          ./dev-tools/scripts/monitor-progress.sh 
