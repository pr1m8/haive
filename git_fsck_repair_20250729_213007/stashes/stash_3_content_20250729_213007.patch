--- /dev/null
+++ b/.github/actions/python-detect-package-manager/action.yml
@@ -0,0 +1,56 @@
+name: "Detect Package Manager"
+description: "Detects if this project uses requirements.txt, Poetry, Pipenv, or setup.py and sets outputs."
+inputs: {}
+outputs:
+  manager:
+    description: "One of requirements, poetry, pipenv, setup"
+  manifest:
+    description: "The manifest file to use (e.g. requirements.txt or pyproject.toml)"
+runs:
+  using: "composite"
+  steps:
+    - name: Check for requirements.txt
+      id: req
+      run: |
+        if [[ -f requirements.txt ]]; then
+          echo "manager=requirements" >> $GITHUB_OUTPUT
+          echo "manifest=requirements.txt" >> $GITHUB_OUTPUT
+          exit 0
+        fi
+        echo "req_missing=true" >> $GITHUB_OUTPUT
+
+    - name: Check for Poetry
+      id: poetry
+      run: |
+        if [[ -f pyproject.toml ]] && grep -q '\[tool.poetry\]' pyproject.toml; then
+          echo "manager=poetry" >> $GITHUB_OUTPUT
+          echo "manifest=pyproject.toml" >> $GITHUB_OUTPUT
+          exit 0
+        fi
+        echo "poetry_missing=true" >> $GITHUB_OUTPUT
+
+    - name: Check for Pipenv
+      id: pipenv
+      run: |
+        if [[ -f Pipfile ]]; then
+          echo "manager=pipenv" >> $GITHUB_OUTPUT
+          echo "manifest=Pipfile" >> $GITHUB_OUTPUT
+          exit 0
+        fi
+        echo "pipenv_missing=true" >> $GITHUB_OUTPUT
+
+    - name: Check for setup.py
+      id: setup
+      run: |
+        if [[ -f setup.py ]]; then
+          echo "manager=setup" >> $GITHUB_OUTPUT
+          echo "manifest=setup.py" >> $GITHUB_OUTPUT
+          exit 0
+        fi
+        echo "setup_missing=true" >> $GITHUB_OUTPUT
+
+    - name: Fail if no manager found
+      if: ${{ always() && (needs.detect.outputs.manager == '') }}
+      run: |
+        echo "No supported manifest found" >&2
+        exit 1
