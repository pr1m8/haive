        -- Function to get a secret value from vault
        CREATE OR REPLACE FUNCTION get_vault_secret(secret_id UUID)
        RETURNS TEXT
        LANGUAGE plpgsql
        SECURITY DEFINER
        AS $$
        DECLARE
            secret_value TEXT;
        BEGIN
            SELECT decrypted_secret INTO secret_value
            FROM vault.decrypted_secrets
            WHERE id = secret_id;
            
            RETURN secret_value;
        END;
        $$;
        
        -- Function to get a secret value by name
        CREATE OR REPLACE FUNCTION get_vault_secret_by_name(secret_name TEXT)
        RETURNS TEXT
        LANGUAGE plpgsql
        SECURITY DEFINER
        AS $$
        DECLARE
            secret_value TEXT;
        BEGIN
            SELECT decrypted_secret INTO secret_value
            FROM vault.decrypted_secrets
            WHERE name = secret_name;
            
            RETURN secret_value;
        END;
        $$;
        
