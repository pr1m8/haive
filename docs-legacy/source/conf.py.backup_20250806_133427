def skip_problematic_members(app, what, name, obj, skip, options):
    """Skip only the specific base.T member that causes KeyError."""
    # Only skip the exact problematic reference
    if name == "base.T":
        print(f"🚫 Skipping problematic member: {name}")
        return True
    return skip

def skip_empty_files(app, what, name, obj, skip, options):
    """Skip empty Python files that cause viewcode IndexError."""
    import os
    if what == "module" and hasattr(obj, "_module_path"):
        try:
            if os.path.getsize(obj._module_path) == 0:
                print(f"🚫 Skipping empty file: {name}")
                return True
        except (AttributeError, OSError):
            pass
    return skip

def setup(app):
    """Setup function for Sphinx configuration."""
    app.connect("autoapi-skip-member", skip_problematic_members)
    app.connect("autoapi-skip-member", skip_empty_files)
    
    # Apply viewcode monkey patch early to fix IndexError
    try:
        from viewcode_monkey_patch import apply_viewcode_monkey_patch
        apply_viewcode_monkey_patch()
        print("✅ viewcode monkey patch applied successfully")
    except ImportError:
        # Fallback to viewcode_safe if monkey patch not available
        try:
            from viewcode_safe import setup_viewcode_safe
            setup_viewcode_safe(app)
            print("✅ viewcode safety patches applied")
        except Exception as e:
            print(f"⚠️  Could not apply viewcode patches: {e}")

