{
  "folders": [
    {
      "name": "haive-monorepo",
      "path": "."
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.analysis.extraPaths": [
      "./packages/haive-core/src",
      "./packages/haive-agents/src",
      "./packages/haive-games/src",
      "./packages/haive-prebuilt/src",
      "./packages/haive-tools/src",
      "./packages/haive-dataflow/src"
    ],
    "python.envFile": "${workspaceFolder}/.env",
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": [
      "packages/haive-core/tests",
      "packages/haive-agents/tests",
      "packages/haive-games/tests",
      "packages/haive-prebuilt/tests",
      "packages/haive-tools/tests",
      "packages/haive-dataflow/tests"
    ],
    "editor.formatOnSave": true,
    "python.analysis.typeCheckingMode": "basic",
    "python.linting.enabled": true,
    "python.linting.pylintEnabled": true,
    "terminal.integrated.cwd": "${workspaceFolder}",
    "files.exclude": {
      "**/__pycache__": true,
      "**/*.pyc": true,
      "**/*.pyo": true,
      "**/.mypy_cache": true,
      "**/.pytest_cache": true,
      "**/.venv": true,
      "**/node_modules": true
    },
    "files.watcherExclude": {
      "**/__pycache__": true,
      "**/*.pyc": true,
      "**/*.pyo": true,
      "**/.mypy_cache": true,
      "**/.pytest_cache": true,
      "**/.venv": true,
      "**/node_modules": true,
      "**/.git": true
    }
  },
  "launch": {
    "configurations": [],
    "compounds": []
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "esbenp.prettier-vscode",
      "charliermarsh.ruff"
    ]
  }
}