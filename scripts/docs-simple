#!/bin/bash

# Simple Documentation Server Script
# Usage: ./scripts/docs-simple [start|stop|kill|view]

PORT=8003
HOST="0.0.0.0"

case "$1" in
start)
	echo "Starting documentation server on http://localhost:${PORT}"
	cd docs || exit
	poetry run sphinx-autobuild source _build/html --port "${PORT}" --host "${HOST}" --open-browser
	;;
stop)
	echo "Stopping documentation server..."
	pkill -f "sphinx-autobuild.*--port ${PORT}"
	;;
kill)
	echo "Killing all sphinx processes..."
	pkill -9 -f sphinx
	;;
view)
	echo "Opening documentation at http://localhost:${PORT}"
	if command -v xdg-open >/dev/null; then
		xdg-open "http://localhost:${PORT}"
	elif command -v open >/dev/null; then
		open "http://localhost:${PORT}"
	else
		echo "Please open http://localhost:${PORT} in your browser"
	fi
	;;
*)
	echo "Usage: $0 {start|stop|kill|view}"
	echo ""
	echo "Commands:"
	echo "  start - Start documentation server (foreground)"
	echo "  stop  - Stop documentation server"
	echo "  kill  - Kill all sphinx processes"
	echo "  view  - Open documentation in browser"
	echo ""
	echo "Documentation will be available at: http://localhost:${PORT}"
	;;
esac
