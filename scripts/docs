#!/bin/bash

# Documentation Server Wrapper Script
# Usage: ./scripts/docs [start|stop|restart|status]

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "${SCRIPT_DIR}")"
DOCS_SCRIPT="${PROJECT_ROOT}/docs/start_docs_server.sh"

if [[ ! -f "${DOCS_SCRIPT}" ]]; then
	echo "Error: Documentation server script not found at: ${DOCS_SCRIPT}"
	exit 1
fi

exec "${DOCS_SCRIPT}" "$@"
